                                <DataGridTextColumn Header="Độ dốc (%)" Binding="{Binding DoDoc, StringFormat={}{0:0.00}}" Width="100" MinWidth="90"/>
                                <DataGridTextColumn Header="Góc xoay (°)" Binding="{Binding GocXoay, StringFormat={}{0:0.00}}" Width="100" MinWidth="90"/>
                                <DataGridTextColumn Header="Số HN" Binding="{Binding SoHopNoi}" Width="65" MinWidth="60"/>
                                <DataGridTextColumn Header="KC_HN1 (m)" Binding="{Binding KC_HN1, StringFormat={}{0:0.00}}" Width="105" MinWidth="95"/>
                                <DataGridTextColumn Header="KC_HN2 (m)" Binding="{Binding KC_HN2, StringFormat={}{0:0.00}}" Width="105" MinWidth="95" Visibility="{Binding Data.IsNormalCulvertMode, Source={StaticResource MainVmProxy}, Converter={StaticResource BoolToVis}}"/>
                                <DataGridTextColumn Header="B_HT1 (m)" Binding="{Binding B_HT1, StringFormat={}{0:0.00}}" Width="105" MinWidth="95"/>
                                <DataGridTextColumn Header="B_HT2 (m)" Binding="{Binding B_HT2, StringFormat={}{0:0.00}}" Width="105" MinWidth="95" Visibility="{Binding Data.IsNormalCulvertMode, Source={StaticResource MainVmProxy}, Converter={StaticResource BoolToVis}}"/>
                                <DataGridTextColumn Header="Ngàm sân (m)" Binding="{Binding L_Ngam_San, StringFormat={}{0:0.00}}" Width="110" MinWidth="100" Visibility="{Binding Data.IsNormalCulvertMode, Source={StaticResource MainVmProxy}, Converter={StaticResource BoolToVis}}"/>
                                <DataGridTextColumn Header="Khe hở HN (m)" Binding="{Binding Khe_Ho_HN, StringFormat={}{0:0.00}}" Width="110" MinWidth="100" Visibility="{Binding Data.IsNormalCulvertMode, Source={StaticResource MainVmProxy}, Converter={StaticResource BoolToVis}}"/>
                                <DataGridTextColumn Header="L SGC TL (m)" Binding="{Binding L_SGC_TL, StringFormat={}{0:0.00}}" Width="110" MinWidth="95" Visibility="{Binding Data.IsNormalCulvertMode, Source={StaticResource MainVmProxy}, Converter={StaticResource BoolToVis}}"/>
                                <DataGridTextColumn Header="L SGC HL (m)" Binding="{Binding L_SGC_HL, StringFormat={}{0:0.00}}" Width="110" MinWidth="95" Visibility="{Binding Data.IsNormalCulvertMode, Source={StaticResource MainVmProxy}, Converter={StaticResource BoolToVis}}"/>
                                <DataGridTextColumn Header="Ghi chú loại cống" Binding="{Binding GhiChu}" Width="150" MinWidth="130" FontWeight="SemiBold" Foreground="{StaticResource CyanLight}"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusNote}" Width="240" MinWidth="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============================================== -->
            <!-- TAB 02: PARAMETER HÌNH HỌC (QUÉT THEO FAMILY)  -->
            <!-- ============================================== -->
            <TabItem Header="02 PARAMETER HÌNH HỌC">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <!-- Khung 1: Master Definition, Family selection, Batch Apply -->
                        <ColumnDefinition Width="1.15*" MinWidth="480"/>
                        <!-- GridSplitter kéo thả giữa 2 khung dọc -->
                        <ColumnDefinition Width="6"/>
                        <!-- Khung 2: Lý trình Inspector & Override Editor -->
                        <ColumnDefinition Width="*" MinWidth="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- KHUNG 1: CỤM CẤU KIỆN, FAMILY & THAM SỐ CHUNG (ÁP DỤNG HÀNG LOẠT HOẶC MẶC ĐỊNH) -->
                    <GroupBox Grid.Column="0" Header="KHUNG 1: CỤM CẤU KIỆN, FAMILY &amp; THAM SỐ CHUNG (ÁP DỤNG HÀNG LOẠT HOẶC MẶC ĐỊNH)">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Hàng 0: Toolbar lọc cụm cấu kiện, dropdown family, quét, nhóm tham số -->
                                <RowDefinition Height="Auto"/>
                                <!-- Hàng 1: Bảng tham số Khung 1 (CHỈ CÒN 4 CỘT: Chọn, STT, Tham số, Giá trị tùy biến) -->
                                <RowDefinition Height="*"/>
                                <!-- Hàng 2: Thanh công cụ gán thông số theo phạm vi lý trình (Từ STT đến STT) -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- HÀNG 0: TOOLBAR ĐIỀU KHIỂN & BỘ LỌC (HÌNH 4: TÁCH CỐNG ĐÚC SẴN & ĐỔ TẠI CHỖ) -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 1. THANH LỌC CỤM CẤU KIỆN (TÁCH CỐNG ĐÚC SẴN, CỐNG ĐỔ TẠI CHỖ, CỬA XẢ, SÂN GIA CỐ, HỐ GA, TẤT CẢ) -->
                                <Border Grid.Row="0" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Cụm cấu kiện:" VerticalAlignment="Center" Foreground="{StaticResource CyanLight}" FontWeight="Bold" Margin="0,0,8,0"/>

                                            <!-- BỘ LỌC CỐNG THƯỜNG -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}">
                                                <Button Content="🧱 Cống đúc sẵn" Command="{Binding FilterTab02GroupCommand}" CommandParameter="Precast" Margin="0,0,3,0" Padding="8,3" FontSize="11.5">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTab02GroupFilter}" Value="Precast">
                                                                    <Setter Property="Background" Value="#0284C7"/>
                                                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Content="🏗️ Cống đổ tại chỗ" Command="{Binding FilterTab02GroupCommand}" CommandParameter="CastInPlace" Margin="0,0,3,0" Padding="8,3" FontSize="11.5">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCastInPlaceTab02Active}" Value="True">
                                                                    <Setter Property="Background" Value="#0284C7"/>
                                                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Content="🌊 Cửa xả" Command="{Binding FilterTab02GroupCommand}" CommandParameter="Outlet" Margin="0,0,3,0" Padding="8,3" FontSize="11.5">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTab02GroupFilter}" Value="Outlet">
                                                                    <Setter Property="Background" Value="#0284C7"/>
                                                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Content="🛡️ Sân gia cố" Command="{Binding FilterTab02GroupCommand}" CommandParameter="Apron" Margin="0,0,3,0" Padding="8,3" FontSize="11.5">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTab02GroupFilter}" Value="Apron">
                                                                    <Setter Property="Background" Value="#0284C7"/>
                                                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Content="🕳️ Hố ga (Hộp nối)" Command="{Binding FilterTab02GroupCommand}" CommandParameter="Manhole" Margin="0,0,3,0" Padding="8,3" FontSize="11.5">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTab02GroupFilter}" Value="Manhole">
                                                                    <Setter Property="Background" Value="#0284C7"/>
                                                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>

                                            <!-- BỘ LỌC CỐNG KỸ THUẬT -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTechnicalCulvertMode, Converter={StaticResource BoolToVis}}">
                                                <Button Content="🧱 Cống đúc sẵn" Command="{Binding FilterTab02GroupCommand}" CommandParameter="Precast" Margin="0,0,3,0" Padding="8,3" FontSize="11.5">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTab02GroupFilter}" Value="Precast">
                                                                    <Setter Property="Background" Value="#0284C7"/>
                                                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Content="🕳️ Hố kỹ thuật" Command="{Binding FilterTab02GroupCommand}" CommandParameter="TechManhole" Margin="0,0,3,0" Padding="8,3" FontSize="11.5">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTab02GroupFilter}" Value="TechManhole">
                                                                    <Setter Property="Background" Value="#0284C7"/>
                                                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Content="📦 Hộp nối cống" Command="{Binding FilterTab02GroupCommand}" CommandParameter="JunctionBox" Margin="0,0,3,0" Padding="8,3" FontSize="11.5">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTab02GroupFilter}" Value="JunctionBox">
                                                                    <Setter Property="Background" Value="#0284C7"/>
                                                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>

                                            <Button Content="📁 Tất cả" Command="{Binding FilterTab02GroupCommand}" CommandParameter="All" Margin="0,0,3,0" Padding="8,3" FontSize="11.5">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedTab02GroupFilter}" Value="All">
                                                                <Setter Property="Background" Value="#0284C7"/>
                                                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Đang xem: " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding SelectedTab02GroupName}" Foreground="{StaticResource MintLight}" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text=" (" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding FilteredAssignedFamiliesForTab02.Count}" Foreground="{StaticResource TextWhite}" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text=" family)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- 2. DROPDOWN CHỌN FAMILY CỦA CỤM ĐÃ CHỌN & NÚT QUÉT THAM SỐ -->
                                <Border Grid.Row="1" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Dòng 0: Dropdown Chọn Loại cống đổ tại chỗ (chỉ hiển thị khi đang chọn Cụm cống đổ tại chỗ) -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4" Visibility="{Binding IsCastInPlaceTab02Active, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Loại cống đổ tại chỗ:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource CyanLight}" FontWeight="Bold"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding CastInPlaceProfiles}" 
                                                      SelectedItem="{Binding SelectedCastInPlaceProfileForTab02}"
                                                      ToolTip="Chọn loại cống đổ tại chỗ cần gán Family và hiệu chỉnh tham số độc lập"
                                                      Height="26" VerticalContentAlignment="Center">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🔷 " Foreground="#38BDF8"/>
                                                            <TextBlock Text="{Binding TypeName}" Foreground="#FFFFFF" FontWeight="Bold"/>
                                                            <TextBlock Text=" (Cống hộp đổ tại chỗ)" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" FontSize="11"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Dòng 1: Dropdown Family cấu kiện -->
                                        <Grid Grid.Row="1" Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Family cấu kiện:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource CyanLight}" FontWeight="Bold"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding FilteredAssignedFamiliesForTab02}" SelectedItem="{Binding SelectedComponentForTab02}" Height="26" VerticalContentAlignment="Center">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="#1E3A8A" BorderBrush="{StaticResource CyanDark}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                                                                <TextBlock Text="{Binding GroupType}" Foreground="{StaticResource MintLight}" FontSize="10.5" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <TextBlock Text="[" Foreground="{StaticResource CyanLight}" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding CategoryType}" Foreground="{StaticResource CyanLight}" FontWeight="Bold"/>
                                                            <TextBlock Text="] " Foreground="{StaticResource CyanLight}" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding SelectedSymbol.DisplayName}" Foreground="#FFFFFF"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Dòng 2: Nút Sao chép sang cùng cụm -->
                                        <Button Grid.Row="2" Content="📋 SAO CHÉP GIÁ TRỊ ĐÃ NHẬP SANG CÙNG CỤM (CỬA XẢ / SÂN GIA CỐ)" Command="{Binding CopyCustomParamsToOtherComponentsCommand}" Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}" Padding="8,3" Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFF" FontWeight="Bold" HorizontalAlignment="Stretch" ToolTip="Sao chép các giá trị số liệu bạn đã nhập ở cột 'Giá trị tùy biến' sang các cấu kiện khác trong cùng cụm (Cửa xả / Sân gia cố). Chỉ sao chép giá trị số liệu, không sao chép tham số và giữ nguyên các biến Yes/No."/>
                                    </Grid>
                                </Border>

                                <!-- 3. BỘ LỌC THAM SỐ (TẤT CẢ / DIMENSIONS / OTHER / TYPE / INSTANCE / SEARCH) -->
                                <Border Grid.Row="2" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,3">
                                    <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Text="Nhóm:" Foreground="{StaticResource CyanLight}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>

                                        <Button Content="📁 Tất cả" Command="{Binding SetTab02ParamCategoryFilterCommand}" CommandParameter="All" Margin="0,0,3,2" Padding="6,2" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tab02ParamCategoryFilter}" Value="All">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="📐 Kích thước" Command="{Binding SetTab02ParamCategoryFilterCommand}" CommandParameter="Dimensions" Margin="0,0,3,2" Padding="6,2" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tab02ParamCategoryFilter}" Value="Dimensions">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="⚙️ Khác" Command="{Binding SetTab02ParamCategoryFilterCommand}" CommandParameter="Other" Margin="0,0,6,2" Padding="6,2" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tab02ParamCategoryFilter}" Value="Other">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Lọc Type / Instance -->
                                        <Border Width="1" Height="16" Background="{StaticResource NavyBorder}" Margin="0,2,6,2"/>
                                        <CheckBox Content="🏷️ Type" IsChecked="{Binding ShowTypeParams}" Foreground="{StaticResource TextWhite}" VerticalAlignment="Center" Margin="0,0,5,2" ToolTip="Hiển thị thuộc tính Loại (Type)"/>
                                        <CheckBox Content="⚡ Instance" IsChecked="{Binding ShowInstanceParams}" Foreground="{StaticResource MintLight}" VerticalAlignment="Center" Margin="0,0,6,2" ToolTip="Hiển thị thuộc tính Biến thể (Instance)"/>

                                        <!-- Chọn để sao chép giá trị -->
                                        <Border Width="1" Height="16" Background="{StaticResource NavyBorder}" Margin="0,2,6,2"/>
                                        <Button Content="☑️ Tất cả" Command="{Binding SelectAllParamsForCopyCommand}" Margin="0,0,3,2" Padding="5,2" FontSize="10.5" Style="{StaticResource CulvertPresetButtonStyle}" ToolTip="Chọn tất cả các giá trị số liệu đã nhập để sao chép"/>
                                        <Button Content="◻️ Bỏ chọn" Command="{Binding UnselectAllParamsForCopyCommand}" Margin="0,0,6,2" Padding="5,2" FontSize="10.5" Style="{StaticResource CulvertPresetButtonStyle}" ToolTip="Bỏ chọn tất cả giá trị"/>

                                        <!-- Ô tìm kiếm tham số nhanh -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,2">
                                            <TextBlock Text="🔍" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            <TextBox Text="{Binding ParamSearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                                     Width="90" Height="22" VerticalContentAlignment="Center"
                                                     Background="{StaticResource NavyDark}" Foreground="#FFF" BorderBrush="{StaticResource CyanDark}"
                                                     ToolTip="Nhập tên tham số để lọc nhanh"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>
                            </Grid>

                            <!-- HÀNG 1: BẢNG DANH MỤC THAM SỐ KHUNG 1 (CHỈ GIỮ LẠI: CHỌN, STT, THAM SỐ, GIÁ TRỊ TÙY BIẾN) -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredParameterMappings}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserResizeColumns="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" MinWidth="45"/>
                                    <DataGridTextColumn Header="STT" Binding="{Binding STT}" IsReadOnly="True" Width="55" MinWidth="45" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Tham số" Binding="{Binding InternalName}" IsReadOnly="True" Width="*" MinWidth="180" FontWeight="SemiBold" Foreground="{StaticResource CyanLight}"/>

                                    <!-- CỘT GIÁ TRỊ: GÕ SỐ / CHỮ HOẶC CHỌN YES/NO NẾU LÀ BIẾN BOOLEAN -->
                                    <DataGridTemplateColumn Header="Giá trị tùy biến" Width="180" MinWidth="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <ComboBox ItemsSource="{Binding Source={x:Static models:ParameterMappingItem.BooleanOptions}}"
                                                              SelectedItem="{Binding CustomValue, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding IsBooleanType, Converter={StaticResource BoolToVis}}"
                                                              Background="#13233A" Foreground="#38BDF8" FontWeight="Bold"/>
                                                    <TextBox Text="{Binding CustomValue, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsBooleanType, Converter={StaticResource InverseBoolToVis}}"
                                                             Background="#102035" Foreground="#34D399" FontWeight="Bold" Padding="4,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- HÀNG 2: GÁN THÔNG SỐ CẤU KIỆN ĐÃ CHỌN CHO PHẠM VI LÝ TRÌNH (TỪ STT ĐẾN STT) -->
                            <Border Grid.Row="2" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,4,0,0">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="Tổng: " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <TextBlock Text="{Binding AllCulvertRows.Count}" Foreground="{StaticResource TextWhite}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text=" cống" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    </StackPanel>
                                    <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Text="Phạm vi STT: Từ" Foreground="{StaticResource CyanLight}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding BatchFromSTT, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="22" TextAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="đến" Foreground="{StaticResource CyanLight}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding BatchToSTT, UpdateSourceTrigger=PropertyChanged}" Width="45" Height="22" TextAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="⚡ ÁP DỤNG CHO DẢI LÝ TRÌNH" Command="{Binding ApplyAllCustomParamsToStationRangeCommand}" 
                                                Background="{StaticResource MintDark}" Foreground="#FFF" FontWeight="Bold" Padding="10,3" Cursor="Hand" BorderBrush="{StaticResource MintLight}"/>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- SPLITTER GIỮA KHUNG 1 VÀ KHUNG 2 (CHIA DỌC TRÁI - PHẢI) -->
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" 
                                  Background="{StaticResource NavyBorder}" Cursor="SizeWE" ShowsPreview="True"/>

                    <!-- KHUNG 2: KIỂM TRA & TÙY BIẾN THAM SỐ CHI TIẾT THEO TỪNG LÝ TRÌNH -->
                    <GroupBox Grid.Column="2" Header="KHUNG 2: KIỂM TRA &amp; TÙY BIẾN THAM SỐ CHI TIẾT THEO TỪNG LÝ TRÌNH" Margin="2,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Hàng 0: Toolbar chọn lý trình xổ xuống, nút sao chép, làm mới -->
                                <RowDefinition Height="Auto"/>
                                <!-- Hàng 1: Bảng tham số chi tiết của lý trình đã chọn (CHỈ CÒN 4 CỘT: Chọn, STT, Tham số, Giá trị tùy biến) -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- TOOLBAR KHUNG 2 -->
                            <Border Grid.Row="0" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Dòng 1: Chọn lý trình kiểm tra ComboBox chiếm full width -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🎯 Chọn lý trình kiểm tra:" Foreground="{StaticResource CyanLight}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding InspectorCulvertRows}" 
                                                  SelectedItem="{Binding SelectedCulvertRowForInspector}"
                                                  Height="26" VerticalContentAlignment="Center">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="STT " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                        <TextBlock Text="{Binding STT}" FontWeight="Bold" Foreground="{StaticResource MintLight}" FontSize="11.5" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding LyTrinh}" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                                        <TextBlock Text="[" Foreground="{StaticResource CyanLight}" FontSize="10.5"/>
                                                        <TextBlock Text="{Binding LoaiCong}" Foreground="{StaticResource CyanLight}" FontSize="10.5"/>
                                                        <TextBlock Text=" - " Foreground="{StaticResource CyanLight}" FontSize="10.5"/>
                                                        <TextBlock Text="{Binding CauKien}" Foreground="{StaticResource CyanLight}" FontSize="10.5"/>
                                                        <TextBlock Text="]" Foreground="{StaticResource CyanLight}" FontSize="10.5"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Dòng 2: Nút thao tác & thông tin cấu kiện đang xem -->
                                    <DockPanel Grid.Row="1" LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="Cấu kiện: " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding SelectedComponentForTab02.CategoryType}" Foreground="{StaticResource MintLight}" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text=" (" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                            <TextBlock Text="{Binding InspectorParameterMappings.Count}" Foreground="{StaticResource TextWhite}" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text=" tham số)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        </StackPanel>

                                        <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button Content="📋 Sao chép từ Khung 1 sang lý trình này" Command="{Binding CopyKhung1ToInspectorRowCommand}" 
                                                    Margin="0,0,4,0" Padding="8,3" Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFF" FontWeight="SemiBold"
                                                    ToolTip="Sao chép các giá trị tùy biến đang nhập ở Khung 1 sang riêng lý trình đang chọn này"/>
                                            <Button Content="🔄 Làm mới" Command="{Binding RefreshInspectorParamsCommand}" 
                                                    Margin="0,0,4,0" Padding="8,3" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" Foreground="{StaticResource CyanLight}"
                                                    ToolTip="Cập nhật lại danh sách tham số theo lý trình đang chọn"/>
                                        </WrapPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- BẢNG THAM SỐ KHUNG 2 (CHỈ CÓ 4 CỘT: Chọn, STT, Tham số, Giá trị tùy biến) -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding InspectorParameterMappings}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserResizeColumns="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50" MinWidth="45"/>
                                    <DataGridTextColumn Header="STT" Binding="{Binding STT}" IsReadOnly="True" Width="50" MinWidth="40" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Tham số" Binding="{Binding InternalName}" IsReadOnly="True" Width="*" MinWidth="140" FontWeight="SemiBold" Foreground="{StaticResource CyanLight}"/>

                                    <!-- CỘT GIÁ TRỊ TÙY BIẾN CỦA LÝ TRÌNH NÀY -->
                                    <DataGridTemplateColumn Header="Giá trị tùy biến (Lý trình này)" Width="180" MinWidth="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <ComboBox ItemsSource="{Binding Source={x:Static models:ParameterMappingItem.BooleanOptions}}"
                                                              SelectedItem="{Binding CustomValue, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding IsBooleanType, Converter={StaticResource BoolToVis}}"
                                                              Background="#13233A" Foreground="#38BDF8" FontWeight="Bold"/>
                                                    <TextBox Text="{Binding CustomValue, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsBooleanType, Converter={StaticResource InverseBoolToVis}}"
                                                             Background="#102035" Foreground="#34D399" FontWeight="Bold" Padding="4,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============================================== -->
            <!-- TAB 03: VẬT LIỆU CẤU KIỆN (TẠO, TÊN & GÁN MÀU) -->
            <!-- ============================================== -->
            <TabItem Header="03 VẬT LIỆU CẤU KIỆN">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <!-- Cột 1: Bảng gán vật liệu cấu kiện -->
                        <ColumnDefinition Width="4*"/>
                        <!-- Cột 2: Tùy chỉnh chi tiết & Bảng màu -->
                        <ColumnDefinition Width="2.4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KHU VỰC 1: BẢNG DANH MỤC CẤU KIỆN & VẬT LIỆU -->
                    <GroupBox Header="1. DANH MỤC CẤU KIỆN &amp; THIẾT LẬP VẬT LIỆU / MÀU SẮC" Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar Thêm / Xóa / Đồng bộ / Quét -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="➕ Thêm cấu kiện" Command="{Binding AddMaterialItemCommand}" Margin="0,0,5,0" Padding="8,4" Background="{StaticResource MintDark}" Foreground="#FFF" FontWeight="SemiBold"/>
                                <Button Content="➖ Xóa" Command="{Binding RemoveMaterialItemCommand}" Margin="0,0,6,0" Padding="8,4" FontSize="11.5"/>
                                <Button Content="🔄 Đồng bộ từ Tab 01" Command="{Binding SyncMaterialsCommand}" Margin="0,0,5,0" Padding="8,4" Background="{StaticResource CyanDark}" Foreground="#FFF" FontWeight="SemiBold"/>
                                <Button Content="🔄 Quét vật liệu Revit" Command="{Binding ScanRevitMaterialsCommand}" Margin="0,0,6,0" Padding="8,4" BorderBrush="{StaticResource CyanDark}"/>
                                <TextBlock Text="* Tự do thêm/xóa cấu kiện, đổi tên và bấm 🎨 để đổi màu sắc." VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontStyle="Italic"/>
                            </StackPanel>

                            <!-- Thanh Chọn Cụm Cấu Kiện: CỐNG ĐÚC SẴN, CỐNG ĐỔ TẠI CHỖ, CỬA XẢ, SÂN GIA CỐ, HỐ GA (HỘP NỐI), CỐNG KỸ THUẬT, TẤT CẢ -->
                            <Border Grid.Row="1" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                    <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎯 Chọn cụm cấu kiện:" VerticalAlignment="Center" Foreground="{StaticResource CyanLight}" FontWeight="Bold" Margin="0,0,8,0"/>

                                        <Button Content="📁 TẤT CẢ" Command="{Binding SetCulvertTypeForTab03Command}" CommandParameter="TẤT CẢ" Margin="0,0,4,0" Padding="8,4" FontSize="11.5">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCulvertTypeForTab03}" Value="TẤT CẢ">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="📦 CỐNG ĐÚC SẴN" Command="{Binding SetCulvertTypeForTab03Command}" CommandParameter="CỐNG ĐÚC SẴN" Margin="0,0,4,0" Padding="8,4" FontSize="11.5" Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCulvertTypeForTab03}" Value="CỐNG ĐÚC SẴN">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="🏗️ CỐNG ĐỔ TẠI CHỖ" Command="{Binding SetCulvertTypeForTab03Command}" CommandParameter="CỐNG ĐỔ TẠI CHỖ" Margin="0,0,4,0" Padding="8,4" FontSize="11.5" Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCastInPlaceTab03Active}" Value="True">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="🌊 CỬA XẢ" Command="{Binding SetCulvertTypeForTab03Command}" CommandParameter="CỬA XẢ" Margin="0,0,4,0" Padding="8,4" FontSize="11.5" Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCulvertTypeForTab03}" Value="CỬA XẢ">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="🛡️ SÂN GIA CỐ" Command="{Binding SetCulvertTypeForTab03Command}" CommandParameter="SÂN GIA CỐ" Margin="0,0,4,0" Padding="8,4" FontSize="11.5" Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCulvertTypeForTab03}" Value="SÂN GIA CỐ">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="🕳️ HỐ GA (HỘP NỐI)" Command="{Binding SetCulvertTypeForTab03Command}" CommandParameter="HỐ GA (HỘP NỐI)" Margin="0,0,4,0" Padding="8,4" FontSize="11.5" Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCulvertTypeForTab03}" Value="HỐ GA (HỘP NỐI)">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="⚡ CỐNG KỸ THUẬT" Command="{Binding SetCulvertTypeForTab03Command}" CommandParameter="CỐNG KỸ THUẬT" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"
                                                Visibility="{Binding IsTechnicalCulvertMode, Converter={StaticResource BoolToVis}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCulvertTypeForTab03}" Value="CỐNG KỸ THUẬT">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="🕳️ HỐ KỸ THUẬT &amp; HỘP NỐI" Command="{Binding SetCulvertTypeForTab03Command}" CommandParameter="HỐ KỸ THUẬT &amp; HỘP NỐI" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"
                                                Visibility="{Binding IsTechnicalCulvertMode, Converter={StaticResource BoolToVis}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCulvertTypeForTab03}" Value="HỐ KỸ THUẬT &amp; HỘP NỐI">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </WrapPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Đang hiển thị: " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedCulvertTypeForTab03}" Foreground="{StaticResource MintLight}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text=" (" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <TextBlock Text="{Binding FilteredComponentMaterials.Count}" Foreground="{StaticResource TextWhite}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text=" cấu kiện)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- DÒNG LỌC CHI TIẾT LOẠI CỐNG ĐỔ TẠI CHỖ (TAB 03) -->
                                <Border Visibility="{Binding IsCastInPlaceTab03Active, Converter={StaticResource BoolToVis}}" 
                                        Background="#102035" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,5,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Loại cống đổ tại chỗ:" Foreground="{StaticResource CyanLight}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding CastInPlaceProfiles}" 
                                                  SelectedItem="{Binding SelectedCastInPlaceProfileForTab03}"
                                                  ToolTip="Chọn loại cống đổ tại chỗ cần gán vật liệu"
                                                  Height="25" VerticalContentAlignment="Center" MinWidth="200">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🔷 " Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding TypeName}" Foreground="#FFFFFF" FontWeight="Bold"/>
                                                        <TextBlock Text=" (Cống hộp đổ tại chỗ)" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" FontSize="11"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                            <DataGrid x:Name="MaterialsDataGrid" Grid.Row="2" ItemsSource="{Binding FilteredComponentMaterials}" SelectedItem="{Binding SelectedMaterialItem}"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      SelectionChanged="MaterialsDataGrid_SelectionChanged"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserResizeColumns="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Dùng" Binding="{Binding IsActive}" Width="48" MinWidth="42"/>
                                    <DataGridTextColumn Header="Cụm cấu kiện" Binding="{Binding GroupType}" IsReadOnly="True" Width="120" MinWidth="100" Foreground="{StaticResource MintLight}" FontWeight="SemiBold"/>
                                    
                                    <!-- Cột tên cấu kiện: Cho phép chỉnh sửa trực tiếp tên cấu kiện -->
                                    <DataGridTemplateColumn Header="Tên cấu kiện" Width="150" MinWidth="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CategoryType}" VerticalAlignment="Center" Margin="3,0" FontWeight="SemiBold" Foreground="{StaticResource TextLight}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CategoryType, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Family Revit" Binding="{Binding FamilyDisplayName}" IsReadOnly="True" Width="145" MinWidth="120"/>
                                    
                                    <!-- Cột tên vật liệu: Cho phép gõ trực tiếp hoặc chọn từ danh sách -->
                                    <DataGridTemplateColumn Header="Tên vật liệu Revit" Width="200" MinWidth="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MaterialName}" VerticalAlignment="Center" Margin="3,0" Foreground="{StaticResource MintLight}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableRevitMaterials, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Cột Màu sắc hiển thị có nút 🎨 mở Color Dialog ngay trên từng dòng -->
                                    <DataGridTemplateColumn Header="Màu sắc" Width="120" MinWidth="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                                    <Border Width="18" Height="18" CornerRadius="3" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,5,0"
                                                            Background="{Binding ColorBrush}"/>
                                                    <TextBlock Text="{Binding ColorHex}" VerticalAlignment="Center" Foreground="{StaticResource TextLight}" FontSize="11" Margin="0,0,4,0"/>
                                                    <Button Content="🎨" Command="{Binding DataContext.OpenColorPickerForItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Padding="4,1" FontSize="11" ToolTip="Mở bảng chọn màu chi tiết Windows Color Picker"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Độ trong (%)" Binding="{Binding Transparency, StringFormat=N0}" Width="85" MinWidth="75"/>
                                    <DataGridTextColumn Header="Tham số gán" Binding="{Binding MaterialParamName}" Width="105" MinWidth="90"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusNote}" IsReadOnly="True" Width="135" MinWidth="115" Foreground="{StaticResource CyanLight}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <!-- KHU VỰC 2: TÙY CHỈNH CHI TIẾT & BẢNG MÀU SẮC -->
                    <GroupBox Header="2. TÙY CHỈNH CẤU KIỆN ĐANG CHỌN &amp; BẢNG MÀU" Grid.Column="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2">
                                <!-- Thẻ Tùy biến chi tiết cấu kiện đang chọn -->
                                <Border Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                                            <TextBlock Text="🎯 Cấu kiện:" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedMaterialItem.CategoryType, FallbackValue='(Chưa chọn cấu kiện)'}" Foreground="{StaticResource CyanLight}" FontWeight="Bold" FontSize="12.5" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedItemsSummaryText}" Foreground="#FBBF24" FontWeight="Bold" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </WrapPanel>

                                        <!-- Tên vật liệu tùy biến -->
                                        <TextBlock Text="Tên vật liệu Revit (tùy chỉnh):" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding SelectedMaterialItem.MaterialName, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Foreground="{StaticResource MintLight}" Padding="5,4" Margin="0,0,0,6" ToolTip="Nhập tên vật liệu bạn muốn gán hoặc tạo mới trong Revit"/>

                                        <!-- Nút mở Bảng chọn màu Windows Color Picker -->
                                        <TextBlock Text="Màu sắc hiển thị (Color Picker / RGB / Hex):" Foreground="{StaticResource TextMuted}" Margin="0,2,0,2"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="38" Height="32" CornerRadius="4" BorderBrush="#FFFFFF" BorderThickness="1.5"
                                                    Background="{Binding SelectedMaterialItem.ColorBrush}" HorizontalAlignment="Left" ToolTip="Màu sắc hiện tại của cấu kiện"/>
                                            <Button Grid.Column="1" Content="🎨 MỞ BẢNG CHỌN MÀU (COLOR PICKER)..." Command="{Binding OpenColorPickerCommand}"
                                                    Height="32" FontWeight="Bold" FontSize="11.5" Background="{StaticResource CyanDark}" Foreground="#FFF"
                                                    ToolTip="Mở bảng chọn màu chi tiết Windows: cho phép chọn bất kỳ màu nào từ bảng triệu màu hoặc pha màu tùy ý"/>
                                        </Grid>

                                        <!-- Ô chỉnh nhanh R, G, B, Hex -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="1">
                                                <TextBlock Text="Đỏ (R):" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBox Text="{Binding SelectedMaterialItem.ColorR, UpdateSourceTrigger=PropertyChanged}" Padding="2" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="1">
                                                <TextBlock Text="Lục (G):" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBox Text="{Binding SelectedMaterialItem.ColorG, UpdateSourceTrigger=PropertyChanged}" Padding="2" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="1">
                                                <TextBlock Text="Lam (B):" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBox Text="{Binding SelectedMaterialItem.ColorB, UpdateSourceTrigger=PropertyChanged}" Padding="2" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="1">
                                                <TextBlock Text="Mã Hex:" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBox Text="{Binding SelectedMaterialItem.ColorHex, UpdateSourceTrigger=PropertyChanged}" Padding="2" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Độ trong suốt slider -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Độ trong suốt (%):" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedMaterialItem.Transparency, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Giá trị:" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBox Text="{Binding SelectedMaterialItem.Transparency, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Padding="2" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Nút ÁP DỤNG 1 CHẠM CHO CÁC CẤU KIỆN ĐANG QUÉT / CHỌN -->
                                        <Button Content="{Binding ApplyToSelectedGroupButtonText}" 
                                                Command="{Binding ApplyMaterialToSelectedGroupCommand}"
                                                Padding="10,8" Margin="0,0,0,6"
                                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5"
                                                BorderBrush="#38BDF8" BorderThickness="1.5" Cursor="Hand"
                                                ToolTip="Bấm 1 nút để áp dụng ngay Tên vật liệu, Màu sắc, Độ trong suốt từ cấu kiện đang chỉnh cho TẤT CẢ các dòng bạn đang chọn / quét chuột"/>

                                        <!-- Nút Áp dụng cho toàn bộ cấu kiện cùng nhóm cống này -->
                                        <Button Content="👥 Áp dụng cho TẤT CẢ cấu kiện cùng nhóm cống này" 
                                                Command="{Binding ApplyMaterialToCurrentGroupTypeCommand}"
                                                Padding="8,5" Margin="0,0,0,8"
                                                Background="#1E293B" Foreground="{StaticResource CyanLight}" FontWeight="SemiBold" FontSize="11"
                                                BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" Cursor="Hand"
                                                ToolTip="Áp dụng tên vật liệu và màu sắc cho tất cả cấu kiện thuộc cùng nhóm"/>

                                        <!-- Nút tạo ngay vào Revit -->
                                        <Button Content="➕ Tạo / Gán vật liệu này vào Revit ngay" Command="{Binding CreateSelectedMaterialInRevitCommand}"
                                                Padding="10,6" Background="{StaticResource MintDark}" Foreground="#FFF" FontWeight="Bold" BorderBrush="{StaticResource MintLight}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Nút Áp dụng mẫu chuẩn TCVN 1 chạm -->
                                <Button Content="⚡ Áp dụng mẫu vật liệu TCVN chuẩn" Command="{Binding ApplyStandardMaterialPresetCommand}"
                                        Background="{StaticResource CyanDark}" Foreground="#FFF" FontWeight="Bold" Padding="10,7" Margin="0,0,0,8"
                                        BorderBrush="{StaticResource CyanLight}"/>

                                <!-- Thẻ hướng dẫn cơ chế tự động -->
                                <Border Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="💡 CƠ CHẾ GÁN TỰ ĐỘNG KHI TẠO MÔ HÌNH:" FontWeight="Bold" Foreground="{StaticResource CyanLight}"/>
                                        <TextBlock Text="1. Khi bấm 'TIẾN HÀNH DỰNG CỐNG', tool sẽ kiểm tra từng tên vật liệu trong dự án Revit." Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,3,0,1" TextWrapping="Wrap"/>
                                        <TextBlock Text="2. Nếu chưa có -> Tự động khởi tạo Material mới với tên và màu sắc đã thiết lập." Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,0,0,1" TextWrapping="Wrap"/>
                                        <TextBlock Text="3. Gán MaterialId trực tiếp vào tham số vật liệu của cấu kiện." Foreground="{StaticResource TextMuted}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============================================== -->
            <!-- ============================================== -->
            <!-- TAB 04: GÁN THÔNG TIN BIM (TÙY BIẾN ĐỘNG)      -->
            <!-- ============================================== -->
            <TabItem Header="04 GÁN THÔNG TIN BIM">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <!-- Hàng 0: Thanh chọn cụm cấu kiện -->
                        <RowDefinition Height="Auto"/>
                        <!-- Hàng 1: Hai bảng chia đôi theo hàng dọc có Splitter (như Tab 02) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HÀNG 0: THANH CHỌN CỤM CẤU KIỆN & DROPDOWN CẤU KIỆN TRONG CỤM (NÚT SỔ RA Ở TRÊN) -->
                    <Border Grid.Row="0" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" BorderThickness="1" CornerRadius="4" Padding="6,5" Margin="0,0,0,6">
                        <StackPanel>
                            <!-- Dòng 1: Chọn Cụm Cấu Kiện -->
                            <DockPanel LastChildFill="False">
                                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎯 Chọn cụm cấu kiện:" VerticalAlignment="Center" Foreground="{StaticResource CyanLight}" FontWeight="Bold" Margin="0,0,8,0"/>

                                    <Button Content="📁 TẤT CẢ" Command="{Binding SetCulvertTypeForTab04Command}" CommandParameter="TẤT CẢ" Margin="0,0,4,0" Padding="8,4" FontSize="11.5">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCulvertTypeForTab04}" Value="TẤT CẢ">
                                                        <Setter Property="Background" Value="#0284C7"/>
                                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="📦 CỐNG ĐÚC SẴN" Command="{Binding SetCulvertTypeForTab04Command}" CommandParameter="CỐNG ĐÚC SẴN" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"
                                            Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCulvertTypeForTab04}" Value="CỐNG ĐÚC SẴN">
                                                        <Setter Property="Background" Value="#0284C7"/>
                                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="🏗️ CỐNG ĐỔ TẠI CHỖ" Command="{Binding SetCulvertTypeForTab04Command}" CommandParameter="CỐNG ĐỔ TẠI CHỖ" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"
                                            Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCastInPlaceTab04Active}" Value="True">
                                                        <Setter Property="Background" Value="#0284C7"/>
                                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="🌊 CỬA XẢ" Command="{Binding SetCulvertTypeForTab04Command}" CommandParameter="CỬA XẢ" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"
                                            Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCulvertTypeForTab04}" Value="CỬA XẢ">
                                                        <Setter Property="Background" Value="#0284C7"/>
                                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="🛡️ SÂN GIA CỐ" Command="{Binding SetCulvertTypeForTab04Command}" CommandParameter="SÂN GIA CỐ" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"
                                            Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCulvertTypeForTab04}" Value="SÂN GIA CỐ">
                                                        <Setter Property="Background" Value="#0284C7"/>
                                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="🕳️ HỐ GA (HỘP NỐI)" Command="{Binding SetCulvertTypeForTab04Command}" CommandParameter="HỐ GA (HỘP NỐI)" Margin="0,0,4,0" Padding="8,4" FontSize="11.5" Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCulvertTypeForTab04}" Value="HỐ GA (HỘP NỐI)">
                                                        <Setter Property="Background" Value="#0284C7"/>
                                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="⚡ CỐNG KỸ THUẬT" Command="{Binding SetCulvertTypeForTab04Command}" CommandParameter="CỐNG KỸ THUẬT" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"
                                            Visibility="{Binding IsTechnicalCulvertMode, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCulvertTypeForTab04}" Value="CỐNG KỸ THUẬT">
                                                        <Setter Property="Background" Value="#0284C7"/>
                                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="🕳️ HỐ KỸ THUẬT &amp; HỘP NỐI" Command="{Binding SetCulvertTypeForTab04Command}" CommandParameter="HỐ KỸ THUẬT &amp; HỘP NỐI" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"
                                            Visibility="{Binding IsTechnicalCulvertMode, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCulvertTypeForTab04}" Value="HỐ KỸ THUẬT &amp; HỘP NỐI">
                                                        <Setter Property="Background" Value="#0284C7"/>
                                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </WrapPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Cụm đang chọn: " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedCulvertTypeForTab04}" Foreground="{StaticResource MintLight}" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Dòng 2: NÚT SỔ RA CHỌN CẤU KIỆN CHI TIẾT TRONG CỤM (YÊU CẦU CỦA ANH) -->
                            <Border Background="#0F172A" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="340"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="🔽 Cấu kiện chi tiết trong cụm:" Foreground="{StaticResource MintLight}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableTargetScopesForTab04}"
                                              SelectedItem="{Binding SelectedTargetScopeForTab04, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Height="27" VerticalContentAlignment="Center" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold"
                                              ToolTip="Chọn cấu kiện trong cụm để gán thông số BIM phi hình học riêng biệt"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="Đang quản lý thông số cho: " Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                                        <TextBlock Text="{Binding SelectedTargetScopeForTab04}" Foreground="{StaticResource MintLight}" FontWeight="Bold" FontSize="11.5"/>
                                        <TextBlock Text=" (" Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                                        <TextBlock Text="{Binding DisplayedCustomBimParameters.Count}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5"/>
                                        <TextBlock Text=" tham số)" Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- DÒNG LỌC CHI TIẾT LOẠI CỐNG ĐỔ TẠI CHỖ (TAB 04 NẾU CÓ) -->
                            <Border Visibility="{Binding IsCastInPlaceTab04Active, Converter={StaticResource BoolToVis}}" 
                                    Background="#102035" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,5,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Loại cống đổ tại chỗ:" Foreground="{StaticResource CyanLight}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding CastInPlaceProfiles}" 
                                              SelectedItem="{Binding SelectedCastInPlaceProfileForTab04}"
                                              ToolTip="Chọn loại cống đổ tại chỗ cần quản lý tham số BIM động"
                                              Height="25" VerticalContentAlignment="Center" MinWidth="200">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🔷 " Foreground="#38BDF8"/>
                                                    <TextBlock Text="{Binding TypeName}" Foreground="#FFFFFF" FontWeight="Bold"/>
                                                    <TextBlock Text=" (Cống hộp đổ tại chỗ)" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- BẢNG QUẢN LÝ THAM SỐ BIM (CHIẾM TRỌN 100% CHIỀU RỘNG, BỎ BẢNG XEM TRƯỚC VÀ CỘT CẤU KIỆN ÁP DỤNG) -->
                    <GroupBox Header="QUẢN LÝ THÔNG SỐ VÀ THÔNG TIN BIM (PHI HÌNH HỌC)" Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Nút Thao tác Tab 04 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Button Content="🏷️ CẬP NHẬT THÔNG TIN BIM VÀO REVIT" 
                                            Command="{Binding UpdateBimParametersOnlyCommand}" 
                                            Padding="12,5" Background="#059669" BorderBrush="#34D399" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                            ToolTip="Cập nhật nhanh thông tin BIM vào các cấu kiện đã có trong file Revit mà không cần dựng lại 3D!"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="➕ Thêm Parameter" Command="{Binding AddCustomBimParameterCommand}" Margin="0,0,5,0" Padding="10,4" Background="{StaticResource MintDark}" Foreground="#FFF" FontSize="11.5"/>
                                    <Button Content="➖ Xóa" Command="{Binding RemoveCustomBimParameterCommand}" Margin="0,0,5,0" Padding="10,4" FontSize="11.5"/>
                                    <Button Content="🔄 Mặc định" Command="{Binding ResetDefaultBimParametersCommand}" Margin="0,0,5,0" Padding="10,4" FontSize="11.5" BorderBrush="{StaticResource CyanDark}"/>
                                    <Button Content="📋 Đồng bộ tất cả" Command="{Binding CopyBimParametersToScopeCommand}" Padding="10,4" FontSize="11.5" BorderBrush="{StaticResource NavyBorder}" ToolTip="Áp dụng các tham số này cho toàn bộ các cấu kiện"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- DataGrid danh sách BIM Parameters - Chiếm trọn 100% chiều rộng -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DisplayedCustomBimParameters}" SelectedItem="{Binding SelectedCustomBimParameter}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserResizeColumns="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Dùng" Binding="{Binding IsActive}" Width="50" MinWidth="45"/>
                                    <DataGridTextColumn Header="Tên Parameter Revit" Binding="{Binding ParamName, UpdateSourceTrigger=PropertyChanged}" Width="180" MinWidth="140" FontWeight="SemiBold"/>
                                    
                                    <!-- Cột Nhóm Revit (Mặc định Constraints) -->
                                    <DataGridTemplateColumn Header="Nhóm Revit" Width="130" MinWidth="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RevitGroup}" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource CyanLight}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{x:Static models:CustomBimParameterItem.AvailableRevitGroups}"
                                                          SelectedItem="{Binding RevitGroup, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Menu Chèn nhanh Smart Tag -->
                                    <DataGridTemplateColumn Header="Chèn Smart Tag" Width="145" MinWidth="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{x:Static models:CustomBimParameterItem.AvailableSmartTags}"
                                                          SelectedItem="{Binding SelectedSmartTagToInsert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Chọn thẻ để chèn nhanh vào ô giá trị">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Foreground="{StaticResource CyanLight}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Giá trị / Cú pháp gán chiếm toàn bộ phần còn lại (*) -->
                                    <DataGridTextColumn Header="Giá trị / Cú pháp gán (Smart Tag)" Binding="{Binding ValueTemplate, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="200"/>

                                    <!-- Xem trước kết quả mẫu (Preview) -->
                                    <DataGridTemplateColumn Header="Xem trước mẫu" Width="200" MinWidth="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PreviewValue}" Foreground="#34D399" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" ToolTip="Kết quả diễn giải mẫu theo cống"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding Description}" Width="180" MinWidth="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- BOTTOM STATUS & ACTIONS -->
        <Border Grid.Row="3" Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Trạng thái: " Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding ExecutionStatus}" Foreground="{StaticResource MintLight}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="ĐÓNG" Command="{Binding CloseCommand}" Margin="0,0,10,0" Width="85"/>
                    <Button Content="🏷️ CẬP NHẬT BIM &amp; VẬT LIỆU" Command="{Binding UpdateBimAndMaterialsCommand}" Style="{StaticResource BtnUpdateStyle}" Margin="0,0,10,0" ToolTip="Tự động gán/cập nhật lại thông tin BIM (Tab 04) và Vật liệu (Tab 03) cho các cống đã có sẵn trong Revit"/>
                    <Button Content="🚀 THỰC HIỆN TẠO MÔ HÌNH" Command="{Binding ExecutePlacementCommand}" Style="{StaticResource BtnExecuteStyle}" ToolTip="Dựng mới các cống chưa có, hoặc tự động cập nhật thông tin &amp; vật liệu cho các cống đã dựng"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
