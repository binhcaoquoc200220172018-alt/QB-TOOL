<Window x:Class="InfraBIM.CulvertTool.Views.CulvertMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:InfraBIM.CulvertTool.Models"
        xmlns:vm="clr-namespace:InfraBIM.CulvertTool.ViewModels"
        xmlns:local="clr-namespace:InfraBIM.CulvertTool.Views"
        mc:Ignorable="d"
        Title="ĐV_TOOL_HTKT_TNN_RẢI CỐNG NGANG" 
        Height="870" Width="1400"
        MinHeight="720" MinWidth="1160"
        WindowStartupLocation="CenterScreen"
        Background="#0A1120" Foreground="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Converter hiển thị động -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:BindingProxy x:Key="MainVmProxy" Data="{Binding}"/>

        <!-- BẢNG MÀU CHUYÊN NGHIỆP: XANH ĐẬM (NAVY), XANH LƠ (CYAN), XANH LÁ NHẠT (MINT) -->
        <SolidColorBrush x:Key="NavyBg" Color="#0A1120"/>
        <SolidColorBrush x:Key="NavyDark" Color="#0B132B"/>
        <SolidColorBrush x:Key="NavyCard" Color="#132035"/>
        <SolidColorBrush x:Key="NavyCardInner" Color="#182A44"/>
        <SolidColorBrush x:Key="NavyBorder" Color="#223959"/>
        <SolidColorBrush x:Key="NavyBorderFocus" Color="#38BDF8"/>

        <!-- Xanh lơ (Cyan) -->
        <SolidColorBrush x:Key="CyanPrimary" Color="#38BDF8"/>
        <SolidColorBrush x:Key="CyanLight" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="CyanDark" Color="#0284C7"/>

        <!-- Xanh lá nhạt (Mint Green) -->
        <SolidColorBrush x:Key="MintLight" Color="#86EFAC"/>
        <SolidColorBrush x:Key="MintPrimary" Color="#4ADE80"/>
        <SolidColorBrush x:Key="MintDark" Color="#16A34A"/>

        <!-- Màu chữ độ tương phản cao -->
        <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextLight" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#BAE6FD"/>
        <SolidColorBrush x:Key="TextLabel" Color="#E2E8F0"/>

        <!-- Base Styles -->
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource NavyCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NavyBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="#16325C" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                            <TextBlock Text="{Binding}" Foreground="#38BDF8" FontWeight="Bold" FontSize="13"/>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource NavyCardInner}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="#38BDF8"/>
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- ComboBox Dark Theme chuẩn -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#13233A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="8,3,28,3" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#13233A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#13233A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A8A"/>
                    <Setter Property="Foreground" Value="#38BDF8"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NavyCardInner}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="BtnExecuteStyle" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource MintLight}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="BtnUpdateStyle" TargetType="Button">
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanLight}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Preset Culvert Selection Buttons Style with Highlight -->
        <Style x:Key="CulvertPresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NavyCardInner}"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CyanDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CyanPrimary}"/>
                                <Setter TargetName="border" Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl Dark Navy Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource NavyBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource NavyCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NavyBorder}"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4,4,0,0" 
                                Margin="0,0,3,0" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#16325C"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CyanLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styles with Auto Scrollbars and Segoe UI -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource NavyCardInner}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource NavyBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#132035"/>
            <Setter Property="AlternatingRowBackground" Value="#0F1B2F"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource NavyBorder}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource NavyBorder}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#16325C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="#16325C" BorderBrush="#0284C7" BorderThickness="0,0,1,2" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#224068"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main 4 Workflow Tabs -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Bottom Status & Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0" Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E3A5F" CornerRadius="6" Padding="6,3" Margin="0,0,10,0">
                        <TextBlock Text="ĐV" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource CyanPrimary}"/>
                    </Border>
                    <TextBlock Text="ĐV_TOOL_HTKT" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CyanPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text=" | TNN - RẢI CỐNG NGANG ĐƯỜNG TỰ ĐỘNG (REVIT 2025)" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource MintLight}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾 Lưu vào File Revit" Command="{Binding SaveProjectConfigCommand}" Margin="0,0,8,0" Padding="10,4" Background="#0D9488" BorderBrush="#2DD4BF" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Cursor="Hand" ToolTip="Lưu toàn bộ thông số và thiết lập 4 Tab trực tiếp vào file Revit (.rvt). Lần sau mở Revit lên là tự động có sẵn toàn bộ dữ liệu!"/>
                    <Button Content="💾 Xuất Preset" Command="{Binding ExportPresetCommand}" Margin="0,0,8,0" Padding="8,4" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" Foreground="{StaticResource TextLight}" FontSize="11.5" Cursor="Hand" ToolTip="Xuất toàn bộ cấu hình 4 Tab ra file Preset (.json) để chia sẻ hoặc lưu mẫu cho dự án khác"/>
                    <Button Content="📂 Nạp Preset" Command="{Binding ImportPresetCommand}" Margin="0,0,10,0" Padding="8,4" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" Foreground="{StaticResource TextLight}" FontSize="11.5" Cursor="Hand" ToolTip="Nạp toàn bộ cấu hình từ file Preset (.json)"/>
                    <Button Content="📄 Tạo Excel mẫu 21 cột" Command="{Binding CreateSampleExcelCommand}" Margin="0,0,10,0" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}"/>
                    <Button Content="🔍 KIỂM TRA MÔ HÌNH 3D" Command="{Binding Open3DReviewCommand}" Padding="14,4" Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" Cursor="Hand" ToolTip="Kiểm tra trực quan mô hình 3D chính xác 100% hình học family trước khi thực hiện"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 4 WORKFLOW TABS -->
        <TabControl Grid.Row="1" Background="{StaticResource NavyBg}" BorderThickness="0" Margin="4">

            <!-- ============================================== -->
            <!-- TAB 01: KHAI BÁO & VỊ TRÍ                       -->
            <!-- ============================================== -->
            <TabItem Header="01 KHAI BÁO &amp; VỊ TRÍ">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <!-- Khung 1: Nguồn Dữ liệu & Family Revit -->
                            <ColumnDefinition Width="340"/>
                            <!-- Khung 2: Cụm Cấu Kiện Lắp Ghép & Thiết Lập Rải Đốt -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- KHUNG 1: NGUỒN DỮ LIỆU EXCEL & FAMILY REVIT -->
                        <GroupBox Header="1. NGUỒN DỮ LIỆU &amp; FAMILY REVIT" Grid.Column="0">
                            <StackPanel Margin="1">
                                <!-- NẠP TỰ ĐỘNG THƯ MỤC FAMILY REVIT -->
                                <Border Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" BorderThickness="1" CornerRadius="4" Padding="6,5" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="📂 Thư mục Family Revit (.rfa):" FontWeight="Bold" Foreground="{StaticResource CyanLight}" Margin="0,0,0,2"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding FamilyFolderPath, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" FontSize="11.5"/>
                                            <Button Grid.Column="1" Content="..." Command="{Binding BrowseFamilyFolderCommand}" ToolTip="Chọn thư mục và tự động nạp Family vào Revit" Width="32" Margin="4,0,0,0" BorderBrush="{StaticResource CyanDark}"/>
                                        </Grid>
                                        <Button Content="📥 Nạp tự động Family vào Revit" Command="{Binding LoadFamiliesFromFolderCommand}" Padding="0,4" FontSize="11.5" FontWeight="SemiBold" Background="#16325C" BorderBrush="{StaticResource CyanLight}"/>
                                        <TextBlock Text="{Binding FamilyLoadStatus}" Foreground="{StaticResource MintLight}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Đường dẫn file Excel (.xlsx):" Margin="0,2,0,2" Foreground="{StaticResource TextMuted}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ExcelFilePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Padding="4,3"/>
                                    <Button Grid.Column="1" Content="..." Command="{Binding BrowseExcelCommand}" Width="36" Margin="4,0,0,0" BorderBrush="{StaticResource CyanDark}"/>
                                </Grid>

                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                        <TextBlock Text="Chọn Sheet:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding SheetNames}" SelectedItem="{Binding SelectedSheetName}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                        <TextBlock Text="Xử lý trùng lặp:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                        <ComboBox ItemsSource="{Binding DuplicateOptions}" SelectedIndex="{Binding SelectedDuplicateOptionIndex}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Hệ tọa độ chuyển đổi:" Margin="0,2,0,2" Foreground="{StaticResource TextMuted}"/>
                                <ComboBox ItemsSource="{Binding CoordinateSystems}" SelectedIndex="{Binding SelectedCoordSysIndex}"/>

                                <Button Content="🔄 Đọc lại file Excel" Command="{Binding ReloadExcelCommand}" Margin="0,6,0,6" Padding="0,5" BorderBrush="{StaticResource CyanDark}"/>

                                <Border Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,2,0,0">
                                    <StackPanel>
                                        <TextBlock Text="📊 DỮ LIỆU ĐANG NẠP:" FontWeight="Bold" Foreground="{StaticResource CyanLight}" FontSize="11.5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Số cống hợp lệ sẵn sàng: " Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                                            <TextBlock Text="{Binding FilteredCulvertRows.Count}" Foreground="{StaticResource MintLight}" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- KHUNG 2: CỤM CẤU KIỆN LẮP GHÉP & THIẾT LẬP RẢI ĐỐT -->
                        <GroupBox Header="2. CỤM CẤU KIỆN LẮP GHÉP &amp; THIẾT LẬP RẢI ĐỐT (CỐNG ĐÚC SẴN - CỐNG ĐỔ TẠI CHỖ - CỬA XẢ - SÂN GIA CỐ - HỐ GA)" Grid.Column="1">
                            <Grid>
                                <!-- CHẾ ĐỘ 1: CỐNG NGANG THÔNG THƯỜNG (4 CỤM CHUẨN DỰ ÁN) -->
                                <TabControl Visibility="{Binding IsNormalCulvertMode, Converter={StaticResource BoolToVis}}" Background="Transparent" BorderThickness="0" Margin="0,1,0,0">
                                    <!-- SUB-TAB 1: CỐNG HỘP ĐÚC SẴN -->
                                    <TabItem Header="📦 CỐNG ĐÚC SẴN" Padding="12,4" FontSize="11.5">
                                        <Grid Margin="0,4,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- HÀNG 0: THIẾT LẬP THÔNG SỐ RẢI ĐỐT CHO CỐNG ĐÚC SẴN (TÍCH HỢP TRỰC TIẾP) -->
                                            <Border Grid.Row="0" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
