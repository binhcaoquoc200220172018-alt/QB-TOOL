                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="⚙️ Khác (Other)" Command="{Binding SetTab02ParamCategoryFilterCommand}" CommandParameter="Other" Margin="0,0,10,0" Padding="8,3" FontSize="11.5">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource CulvertPresetButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tab02ParamCategoryFilter}" Value="Other">
                                                                <Setter Property="Background" Value="#0284C7"/>
                                                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Lọc Type / Instance -->
                                            <Border Width="1" Background="{StaticResource NavyBorder}" Margin="2,2,8,2"/>
                                            <CheckBox Content="🏷️ Type" IsChecked="{Binding ShowTypeParams}" Foreground="{StaticResource TextWhite}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Hiển thị thuộc tính Loại (Type)"/>
                                            <CheckBox Content="⚡ Instance" IsChecked="{Binding ShowInstanceParams}" Foreground="{StaticResource MintLight}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Hiển thị thuộc tính Biến thể (Instance)"/>
                                        </StackPanel>

                                        <!-- Ô tìm kiếm tham số nhanh -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔍 Tìm:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBox Text="{Binding ParamSearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                                     Width="110" Height="22" VerticalContentAlignment="Center"
                                                     Background="{StaticResource NavyDark}" Foreground="#FFF" BorderBrush="{StaticResource CyanDark}"
                                                     ToolTip="Nhập tên tham số để lọc nhanh"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- HÀNG 1: BẢNG DANH MỤC THAM SỐ GỘP CHUNG (GIỮ NGUYÊN THỨ TỰ FAMILY & TÙY BIẾN GIÁ TRỊ) -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredParameterMappings}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserResizeColumns="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT" Binding="{Binding STT}" IsReadOnly="True" Width="55" MinWidth="45" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Tham số (Family Order)" Binding="{Binding InternalName}" IsReadOnly="True" Width="260" MinWidth="180" FontWeight="SemiBold" Foreground="{StaticResource CyanLight}"/>
                                    <DataGridTextColumn Header="Nhóm tham số" Binding="{Binding GroupName}" IsReadOnly="True" Width="140" MinWidth="110"/>
                                    <DataGridTextColumn Header="Kiểu dữ liệu" Binding="{Binding DataType}" IsReadOnly="True" Width="130" MinWidth="105"/>
                                    <DataGridTextColumn Header="Giá trị mặc định" Binding="{Binding DefaultValue}" IsReadOnly="True" Width="120" MinWidth="95"/>

                                    <!-- CỘT GIÁ TRỊ: GÕ SỐ / CHỮ HOẶC CHỌN YES/NO NẾU LÀ BIẾN BOOLEAN -->
                                    <DataGridTemplateColumn Header="Giá trị tùy biến" Width="170" MinWidth="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <ComboBox ItemsSource="{Binding Source={x:Static models:ParameterMappingItem.BooleanOptions}}"
                                                              SelectedItem="{Binding CustomValue, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding IsBooleanType, Converter={StaticResource BoolToVis}}"
                                                              Background="#13233A" Foreground="#38BDF8" FontWeight="Bold"/>
                                                    <TextBox Text="{Binding CustomValue, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsBooleanType, Converter={StaticResource InverseBoolToVis}}"
                                                             Background="#102035" Foreground="#34D399" FontWeight="Bold" Padding="4,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Ánh xạ cột Excel" Binding="{Binding MappedField}" Width="120" MinWidth="100"/>
                                    <DataGridTextColumn Header="Phân loại" Binding="{Binding InstanceTypeBadge}" IsReadOnly="True" Width="120" MinWidth="95"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- HÀNG 2: GÁN THÔNG SỐ CẤU KIỆN ĐÃ CHỌN CHO PHẠM VI LÝ TRÌNH (TỪ STT ĐẾN STT) -->
                            <Border Grid.Row="2" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,5,0,5">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡ Gán thông số cấu kiện này cho phạm vi lý trình:" Foreground="{StaticResource CyanLight}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="Từ STT:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding BatchFromSTT, UpdateSourceTrigger=PropertyChanged}" Width="55" Height="24" TextAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Đến STT:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding BatchToSTT, UpdateSourceTrigger=PropertyChanged}" Width="55" Height="24" TextAlignment="Center" Margin="0,0,14,0"/>
                                        <Button Content="⚡ ÁP DỤNG CHO CÁC LÝ TRÌNH ĐÃ CHỌN" Command="{Binding ApplyAllCustomParamsToStationRangeCommand}" 
                                                Background="{StaticResource MintDark}" Foreground="#FFF" FontWeight="Bold" Padding="14,4" Cursor="Hand" BorderBrush="{StaticResource MintLight}"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tổng số cống trong dự án: " Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                                        <TextBlock Text="{Binding AllCulvertRows.Count}" Foreground="{StaticResource TextWhite}" FontWeight="Bold" FontSize="11.5"/>
                                        <TextBlock Text=" cống" Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- HÀNG 3: BẢNG TỔNG HỢP LÝ TRÌNH TỪ TRÊN XUỐNG THEO THỨ TỰ STT ĐỂ DỄ THEO DÕI VÀ CHỌN KHOẢNG STT -->
                            <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredCulvertRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserResizeColumns="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT" Binding="{Binding STT}" IsReadOnly="True" Width="60" MinWidth="50" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Lý trình" Binding="{Binding LyTrinh}" IsReadOnly="True" Width="130" MinWidth="100" FontWeight="SemiBold" Foreground="{StaticResource MintLight}"/>
                                    <DataGridTextColumn Header="Loại cống" Binding="{Binding LoaiCong}" IsReadOnly="True" Width="140" MinWidth="110"/>
                                    <DataGridTextColumn Header="Cấu kiện" Binding="{Binding CauKien}" IsReadOnly="True" Width="120" MinWidth="90"/>
                                    <DataGridTextColumn Header="Số cửa" Binding="{Binding SoCua}" IsReadOnly="True" Width="65" MinWidth="55"/>
                                    <DataGridTextColumn Header="Khẩu độ" Binding="{Binding KhauDo}" IsReadOnly="True" Width="110" MinWidth="90"/>
                                    <DataGridTextColumn Header="Chiều dài (m)" Binding="{Binding ChieuDai, StringFormat={}{0:0.00}}" IsReadOnly="True" Width="105" MinWidth="90"/>
                                    <DataGridTextColumn Header="Độ dốc (%)" Binding="{Binding DoDoc, StringFormat={}{0:0.00}}" IsReadOnly="True" Width="95" MinWidth="85"/>
                                    <DataGridTextColumn Header="Ghi chú cống" Binding="{Binding GhiChu}" IsReadOnly="True" Width="200" MinWidth="150" Foreground="{StaticResource CyanLight}"/>
                                    <DataGridTextColumn Header="Trạng thái cống" Binding="{Binding StatusNote}" IsReadOnly="True" Width="*" MinWidth="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============================================== -->
            <!-- TAB 03: VẬT LIỆU CẤU KIỆN (TẠO, TÊN & GÁN MÀU) -->
            <!-- ============================================== -->
            <TabItem Header="03 VẬT LIỆU CẤU KIỆN">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <!-- Cột 1: Bảng gán vật liệu cấu kiện -->
                        <ColumnDefinition Width="4*"/>
                        <!-- Cột 2: Tùy chỉnh chi tiết & Bảng màu -->
                        <ColumnDefinition Width="2.4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KHU VỰC 1: BẢNG DANH MỤC CẤU KIỆN & VẬT LIỆU -->
                    <GroupBox Header="1. DANH MỤC CẤU KIỆN &amp; THIẾT LẬP VẬT LIỆU / MÀU SẮC" Grid.Column="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar Thêm / Xóa / Đồng bộ / Quét -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="➕ Thêm cấu kiện" Command="{Binding AddMaterialItemCommand}" Margin="0,0,5,0" Padding="8,4" Background="{StaticResource MintDark}" Foreground="#FFF" FontWeight="SemiBold"/>
                                <Button Content="➖ Xóa" Command="{Binding RemoveMaterialItemCommand}" Margin="0,0,6,0" Padding="8,4" FontSize="11.5"/>
                                <Button Content="🔄 Đồng bộ từ Tab 01" Command="{Binding SyncMaterialsCommand}" Margin="0,0,5,0" Padding="8,4" Background="{StaticResource CyanDark}" Foreground="#FFF" FontWeight="SemiBold"/>
                                <Button Content="🔄 Quét vật liệu Revit" Command="{Binding ScanRevitMaterialsCommand}" Margin="0,0,6,0" Padding="8,4" BorderBrush="{StaticResource CyanDark}"/>
                                <TextBlock Text="* Tự do thêm/xóa cấu kiện, đổi tên và bấm 🎨 để đổi màu sắc." VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontStyle="Italic"/>
                            </StackPanel>

                            <!-- Thanh Lọc Cụm Cấu Kiện (Khớp 4 cụm ở Tab 01: Thân cống, Cửa xả, Sân gia cố, Hố ga) -->
                            <Border Grid.Row="1" Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource CyanDark}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Lọc cụm cấu kiện:" VerticalAlignment="Center" Foreground="{StaticResource CyanLight}" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <Button Content="📁 Tất cả" Command="{Binding FilterMaterialGroupCommand}" CommandParameter="All" Margin="0,0,4,0" Padding="8,3" FontSize="11.5"/>
                                        <Button Content="🧱 Thân cống" Command="{Binding FilterMaterialGroupCommand}" CommandParameter="Barrel" Margin="0,0,4,0" Padding="8,3" FontSize="11.5"/>
                                        <Button Content="🌊 Cửa xả" Command="{Binding FilterMaterialGroupCommand}" CommandParameter="Outlet" Margin="0,0,4,0" Padding="8,3" FontSize="11.5"/>
                                        <Button Content="🛡️ Sân gia cố" Command="{Binding FilterMaterialGroupCommand}" CommandParameter="Apron" Margin="0,0,4,0" Padding="8,3" FontSize="11.5"/>
                                        <Button Content="🕳️ Hố ga (Hộp nối)" Command="{Binding FilterMaterialGroupCommand}" CommandParameter="Manhole" Margin="0,0,4,0" Padding="8,3" FontSize="11.5"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Đang hiển thị: " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedMaterialGroupFilterName}" Foreground="{StaticResource MintLight}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text=" (" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        <TextBlock Text="{Binding FilteredComponentMaterials.Count}" Foreground="{StaticResource TextWhite}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text=" cấu kiện)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredComponentMaterials}" SelectedItem="{Binding SelectedMaterialItem}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserResizeColumns="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Dùng" Binding="{Binding IsActive}" Width="48" MinWidth="42"/>
                                    <DataGridTextColumn Header="Cụm cấu kiện" Binding="{Binding GroupType}" IsReadOnly="True" Width="120" MinWidth="100" Foreground="{StaticResource MintLight}" FontWeight="SemiBold"/>
                                    
                                    <!-- Cột tên cấu kiện: Cho phép chỉnh sửa trực tiếp tên cấu kiện -->
                                    <DataGridTemplateColumn Header="Tên cấu kiện" Width="150" MinWidth="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CategoryType}" VerticalAlignment="Center" Margin="3,0" FontWeight="SemiBold" Foreground="{StaticResource TextLight}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CategoryType, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Family Revit" Binding="{Binding FamilyDisplayName}" IsReadOnly="True" Width="145" MinWidth="120"/>
                                    
                                    <!-- Cột tên vật liệu: Cho phép gõ trực tiếp hoặc chọn từ danh sách -->
                                    <DataGridTemplateColumn Header="Tên vật liệu Revit" Width="200" MinWidth="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MaterialName}" VerticalAlignment="Center" Margin="3,0" Foreground="{StaticResource MintLight}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableRevitMaterials, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Cột Màu sắc hiển thị có nút 🎨 mở Color Dialog ngay trên từng dòng -->
                                    <DataGridTemplateColumn Header="Màu sắc" Width="120" MinWidth="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                                    <Border Width="18" Height="18" CornerRadius="3" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,5,0"
                                                            Background="{Binding ColorBrush}"/>
                                                    <TextBlock Text="{Binding ColorHex}" VerticalAlignment="Center" Foreground="{StaticResource TextLight}" FontSize="11" Margin="0,0,4,0"/>
                                                    <Button Content="🎨" Command="{Binding DataContext.OpenColorPickerForItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Padding="4,1" FontSize="11" ToolTip="Mở bảng chọn màu chi tiết Windows Color Picker"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Độ trong (%)" Binding="{Binding Transparency, StringFormat=N0}" Width="85" MinWidth="75"/>
                                    <DataGridTextColumn Header="Tham số gán" Binding="{Binding MaterialParamName}" Width="105" MinWidth="90"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusNote}" IsReadOnly="True" Width="135" MinWidth="115" Foreground="{StaticResource CyanLight}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <!-- KHU VỰC 2: TÙY CHỈNH CHI TIẾT & BẢNG MÀU SẮC -->
                    <GroupBox Header="2. TÙY CHỈNH CẤU KIỆN ĐANG CHỌN &amp; BẢNG MÀU" Grid.Column="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2">
                                <!-- Thẻ Tùy biến chi tiết cấu kiện đang chọn -->
                                <Border Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="🎯 Cấu kiện:" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedMaterialItem.CategoryType, FallbackValue='(Chưa chọn cấu kiện)'}" Foreground="{StaticResource CyanLight}" FontWeight="Bold" FontSize="12.5" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Tên vật liệu tùy biến -->
                                        <TextBlock Text="Tên vật liệu Revit (tùy chỉnh):" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding SelectedMaterialItem.MaterialName, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Foreground="{StaticResource MintLight}" Padding="5,4" Margin="0,0,0,6" ToolTip="Nhập tên vật liệu bạn muốn gán hoặc tạo mới trong Revit"/>

                                        <!-- Nút mở Bảng chọn màu Windows Color Picker -->
                                        <TextBlock Text="Màu sắc hiển thị (Color Picker / RGB / Hex):" Foreground="{StaticResource TextMuted}" Margin="0,2,0,2"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="38" Height="32" CornerRadius="4" BorderBrush="#FFFFFF" BorderThickness="1.5"
                                                    Background="{Binding SelectedMaterialItem.ColorBrush}" HorizontalAlignment="Left" ToolTip="Màu sắc hiện tại của cấu kiện"/>
                                            <Button Grid.Column="1" Content="🎨 MỞ BẢNG CHỌN MÀU (COLOR PICKER)..." Command="{Binding OpenColorPickerCommand}"
                                                    Height="32" FontWeight="Bold" FontSize="11.5" Background="{StaticResource CyanDark}" Foreground="#FFF"
                                                    ToolTip="Mở bảng chọn màu chi tiết Windows: cho phép chọn bất kỳ màu nào từ bảng triệu màu hoặc pha màu tùy ý"/>
                                        </Grid>

                                        <!-- Ô chỉnh nhanh R, G, B, Hex -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="1">
                                                <TextBlock Text="Đỏ (R):" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBox Text="{Binding SelectedMaterialItem.ColorR, UpdateSourceTrigger=PropertyChanged}" Padding="2" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="1">
                                                <TextBlock Text="Lục (G):" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBox Text="{Binding SelectedMaterialItem.ColorG, UpdateSourceTrigger=PropertyChanged}" Padding="2" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="1">
                                                <TextBlock Text="Lam (B):" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBox Text="{Binding SelectedMaterialItem.ColorB, UpdateSourceTrigger=PropertyChanged}" Padding="2" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="1">
                                                <TextBlock Text="Mã Hex:" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBox Text="{Binding SelectedMaterialItem.ColorHex, UpdateSourceTrigger=PropertyChanged}" Padding="2" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Độ trong suốt slider -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Độ trong suốt (%):" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedMaterialItem.Transparency, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Giá trị:" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                <TextBox Text="{Binding SelectedMaterialItem.Transparency, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Padding="2" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Nút tạo ngay vào Revit -->
                                        <Button Content="➕ Tạo / Gán vật liệu này vào Revit ngay" Command="{Binding CreateSelectedMaterialInRevitCommand}"
                                                Padding="10,6" Background="{StaticResource MintDark}" Foreground="#FFF" FontWeight="Bold" BorderBrush="{StaticResource MintLight}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Nút Áp dụng mẫu chuẩn TCVN 1 chạm -->
                                <Button Content="⚡ Áp dụng mẫu vật liệu TCVN chuẩn" Command="{Binding ApplyStandardMaterialPresetCommand}"
                                        Background="{StaticResource CyanDark}" Foreground="#FFF" FontWeight="Bold" Padding="10,7" Margin="0,0,0,8"
                                        BorderBrush="{StaticResource CyanLight}"/>

                                <!-- Bảng màu nhanh chuyên ngành hạ tầng -->
                                <Border Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="🎨 BẢNG MÀU NHANH HẠ TẦNG (1 CHẠM):" FontWeight="Bold" Foreground="{StaticResource CyanLight}" Margin="0,0,0,6"/>
                                        <UniformGrid Columns="4" Rows="2" Margin="0,2">
                                            <!-- Ô 1: Bê tông đúc sẵn -->
                                            <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="#BDC3C7" Margin="2" Height="36" ToolTip="Xám bê tông đúc sẵn (#BDC3C7)">
                                                <Border Background="#BDC3C7" Width="30" Height="22" CornerRadius="3" BorderBrush="#000" BorderThickness="0.5"/>
                                            </Button>
                                            <!-- Ô 2: Xám đá tường cánh -->
                                            <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="#95A5A6" Margin="2" Height="36" ToolTip="Xám đá tường cánh (#95A5A6)">
                                                <Border Background="#95A5A6" Width="30" Height="22" CornerRadius="3" BorderBrush="#000" BorderThickness="0.5"/>
                                            </Button>
                                            <!-- Ô 3: Xám đậm hố ga/hộp nối -->
                                            <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="#7F8C8D" Margin="2" Height="36" ToolTip="Xám đậm hố ga / hộp nối (#7F8C8D)">
                                                <Border Background="#7F8C8D" Width="30" Height="22" CornerRadius="3" BorderBrush="#000" BorderThickness="0.5"/>
                                            </Button>
                                            <!-- Ô 4: Xám tro bê tông lót -->
                                            <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="#4A5568" Margin="2" Height="36" ToolTip="Xám tro bê tông lót (#4A5568)">
                                                <Border Background="#4A5568" Width="30" Height="22" CornerRadius="3" BorderBrush="#FFF" BorderThickness="0.5"/>
                                            </Button>
                                            <!-- Ô 5: Vàng cát đầm chặt -->
                                            <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="#ECC94B" Margin="2" Height="36" ToolTip="Vàng cát đầm chặt (#ECC94B)">
                                                <Border Background="#ECC94B" Width="30" Height="22" CornerRadius="3" BorderBrush="#000" BorderThickness="0.5"/>
                                            </Button>
                                            <!-- Ô 6: Xám tím đá dăm đệm -->
                                            <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="#566573" Margin="2" Height="36" ToolTip="Xám tím đá dăm đệm (#566573)">
                                                <Border Background="#566573" Width="30" Height="22" CornerRadius="3" BorderBrush="#FFF" BorderThickness="0.5"/>
                                            </Button>
                                            <!-- Ô 7: Xanh lơ dòng chảy -->
                                            <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="#38BDF8" Margin="2" Height="36" ToolTip="Xanh lơ dòng chảy (#38BDF8)">
                                                <Border Background="#38BDF8" Width="30" Height="22" CornerRadius="3" BorderBrush="#000" BorderThickness="0.5"/>
                                            </Button>
                                            <!-- Ô 8: Đỏ gạch xây -->
                                            <Button Command="{Binding ApplyColorPresetCommand}" CommandParameter="#E53E3E" Margin="2" Height="36" ToolTip="Đỏ gạch xây (#E53E3E)">
                                                <Border Background="#E53E3E" Width="30" Height="22" CornerRadius="3" BorderBrush="#000" BorderThickness="0.5"/>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Thẻ hướng dẫn cơ chế tự động -->
                                <Border Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="💡 CƠ CHẾ GÁN TỰ ĐỘNG KHI TẠO MÔ HÌNH:" FontWeight="Bold" Foreground="{StaticResource CyanLight}"/>
                                        <TextBlock Text="1. Khi bấm 'TIẾN HÀNH DỰNG CỐNG', tool sẽ kiểm tra từng tên vật liệu trong dự án Revit." Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,3,0,1" TextWrapping="Wrap"/>
                                        <TextBlock Text="2. Nếu chưa có -> Tự động khởi tạo Material mới với tên và màu sắc đã thiết lập." Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,0,0,1" TextWrapping="Wrap"/>
                                        <TextBlock Text="3. Gán MaterialId trực tiếp vào tham số vật liệu của cấu kiện." Foreground="{StaticResource TextMuted}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============================================== -->
            <!-- TAB 04: GÁN THÔNG TIN BIM (TÙY BIẾN ĐỘNG)      -->
            <!-- ============================================== -->
            <TabItem Header="04 GÁN THÔNG TIN BIM">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <!-- Khung 1: Tự động hóa & Tag mẫu -->
                            <ColumnDefinition Width="2.2*"/>
                            <!-- Khung 2: Quản lý tham số BIM tùy biến -->
                            <ColumnDefinition Width="3.8*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Khung 1: Tự động tính Tọa độ & Cao độ -->
                        <GroupBox Header="1. THIẾT LẬP TỰ ĐỘNG HÓA CAO ĐỘ &amp; TỌA ĐỘ" Grid.Column="0">
                            <StackPanel Margin="3">
                                <CheckBox Content="Tự động tính &amp; gán 'Cao độ đầu (m)', 'Cao độ cuối (m)' vào Thân cống" IsChecked="{Binding BimConfig.AutoSetElevations}" Margin="0,3" Foreground="{StaticResource TextLight}"/>
                                <CheckBox Content="Tự động tính &amp; gán 'Tọa độ X(m)', 'Tọa độ Y(m)' vào Sân cống / Hộp nối" IsChecked="{Binding BimConfig.AutoSetCoordinates}" Margin="0,3" Foreground="{StaticResource TextLight}"/>
                                <CheckBox Content="Tự động khởi tạo Shared Parameter nếu dự án chưa có" IsChecked="{Binding BimConfig.AutoCreateSharedParameters}" Margin="0,3" Foreground="{StaticResource TextLight}"/>

                                <Border Background="{StaticResource NavyCardInner}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💡 CÁC THẺ CÚ PHÁP ĐỘNG (SMART TAGS):" FontWeight="Bold" Foreground="{StaticResource CyanLight}"/>
                                        <TextBlock Text="{}{STT} : Số thứ tự cống" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{}{LyTrinh} : Lý trình thiết kế (vd: Km10+250)" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{}{LoaiCong} : Chủng loại cống (vd: HOP, TRON)" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{}{KhauDo} : Khẩu độ (vd: D1000, 2x2)" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{}{DoDoc} : Độ dốc cống (%) | {}{GocXoay} : Góc xoay (°)" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{}{ChieuDai} : Chiều dài (m) | {}{X1}, {}{Y1}, {}{Z1} : Tọa độ" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- Khung 2: Quản lý tham số BIM linh hoạt -->
                        <GroupBox Header="2. QUẢN LÝ THAM SỐ BIM TÙY BIẾN THEO TIÊU CHUẨN DỰ ÁN" Grid.Column="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Nút Thêm, Xóa, Mặc định -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                                    <Button Content="➕ Thêm Parameter" Command="{Binding AddCustomBimParameterCommand}" Margin="0,0,4,0" Padding="8,3" Background="{StaticResource MintDark}" Foreground="#FFF" FontSize="11.5"/>
                                    <Button Content="➖ Xóa" Command="{Binding RemoveCustomBimParameterCommand}" Margin="0,0,4,0" Padding="8,3" FontSize="11.5"/>
                                    <Button Content="🔄 Mặc định" Command="{Binding ResetDefaultBimParametersCommand}" Padding="8,3" FontSize="11.5" BorderBrush="{StaticResource CyanDark}"/>
                                </StackPanel>

                                <!-- DataGrid danh sách BIM Parameters có thanh cuộn 2 chiều -->
                                <DataGrid Grid.Row="1" ItemsSource="{Binding CustomBimParameters}" SelectedItem="{Binding SelectedCustomBimParameter}" Height="155"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserResizeColumns="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Dùng" Binding="{Binding IsActive}" Width="50" MinWidth="45"/>
                                        <DataGridTextColumn Header="Tên Parameter Revit" Binding="{Binding ParamName}" Width="180" MinWidth="140"/>
                                        <DataGridTextColumn Header="Cấu kiện áp dụng" Binding="{Binding TargetScope}" Width="140" MinWidth="120"/>
                                        <DataGridTextColumn Header="Mẫu giá trị (Smart Tag)" Binding="{Binding ValueTemplate}" Width="220" MinWidth="160"/>
                                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Description}" Width="160" MinWidth="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Khung 3: Bảng Preview trước khi gán -->
                    <GroupBox Header="3. BẢNG XEM TRƯỚC THÔNG TIN BIM SẼ GÁN CHO CÁC CẤU KIỆN" Grid.Row="1" Margin="0,4,0,0">
                        <DataGrid ItemsSource="{Binding FilteredCulvertRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserResizeColumns="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="60" MinWidth="55"/>
                                <DataGridTextColumn Header="Lý trình" Binding="{Binding LyTrinh}" Width="120" MinWidth="110"/>
                                <DataGridTextColumn Header="Loại cống" Binding="{Binding LoaiCong}" Width="120" MinWidth="110"/>
                                <DataGridTextColumn Header="Khẩu độ" Binding="{Binding KhauDo}" Width="110" MinWidth="100"/>
                                <DataGridTextColumn Header="Cao độ TL Z1 (m)" Binding="{Binding Z1, StringFormat={}{0:0.000}}" Width="130" MinWidth="115"/>
                                <DataGridTextColumn Header="Cao độ HL Z2 (m)" Binding="{Binding Z2, StringFormat={}{0:0.000}}" Width="130" MinWidth="115"/>
                                <DataGridTextColumn Header="Tọa độ X1 (m)" Binding="{Binding X1, StringFormat={}{0:0.000}}" Width="120" MinWidth="110"/>
                                <DataGridTextColumn Header="Tọa độ Y1 (m)" Binding="{Binding Y1, StringFormat={}{0:0.000}}" Width="120" MinWidth="110"/>
                                <DataGridTextColumn Header="Độ dốc (%)" Binding="{Binding DoDoc, StringFormat={}{0:0.00}}" Width="105" MinWidth="95"/>
                                <DataGridTextColumn Header="Góc xoay (°)" Binding="{Binding GocXoay, StringFormat={}{0:0.00}}" Width="105" MinWidth="95"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusNote}" Width="240" MinWidth="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============================================== -->
            <!-- TAB 05: KẾT QUẢ KIỂM TRA & THỰC HIỆN            -->
            <!-- ============================================== -->
            <TabItem Header="05 KẾT QUẢ KIỂM TRA &amp; THỰC HIỆN">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <!-- 4 Thẻ trạng thái đỉnh -->
                        <RowDefinition Height="Auto"/>
                        <!-- Bảng kiểm tra chi tiết -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 4 THẺ TRẠNG THÁI ĐỈNH -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Kết luận -->
                        <Border Grid.Column="0" Background="{StaticResource NavyCard}" BorderBrush="{StaticResource CyanPrimary}" BorderThickness="1.5" CornerRadius="6" Padding="10" Margin="3">
                            <StackPanel>
                                <TextBlock Text="KẾT LUẬN KIỂM TRA" FontWeight="Bold" Foreground="{StaticResource CyanLight}"/>
                                <TextBlock Text="{Binding StatusConclusion}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource MintLight}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Lỗi -->
                        <Border Grid.Column="1" Background="{StaticResource NavyCard}" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="6" Padding="10" Margin="3">
                            <StackPanel>
                                <TextBlock Text="LỖI NGHIÊM TRỌNG" FontWeight="Bold" Foreground="#FCA5A5"/>
                                <TextBlock Text="{Binding TotalErrors}" FontSize="20" FontWeight="Bold" Foreground="#EF4444" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Cảnh báo -->
                        <Border Grid.Column="2" Background="{StaticResource NavyCard}" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="6" Padding="10" Margin="3">
                            <StackPanel>
                                <TextBlock Text="CẢNH BÁO SAI SỐ" FontWeight="Bold" Foreground="#FDE68A"/>
                                <TextBlock Text="{Binding TotalWarnings}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Thông tin -->
                        <Border Grid.Column="3" Background="{StaticResource NavyCard}" BorderBrush="{StaticResource CyanDark}" BorderThickness="1.5" CornerRadius="6" Padding="10" Margin="3">
                            <StackPanel>
                                <TextBlock Text="THÔNG TIN HỢP LỆ" FontWeight="Bold" Foreground="{StaticResource CyanLight}"/>
                                <TextBlock Text="{Binding TotalInfos}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CyanPrimary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- BẢNG KIỂM TRA CHI TIẾT -->
                    <GroupBox Header="BẢNG KIỂM TRA TỌA ĐỘ, CHIỀU DÀI, ĐỘ DỐC &amp; KHOẢNG CÁCH HỘP NỐI" Grid.Row="1">
                        <DataGrid ItemsSource="{Binding ValidationResults}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserResizeColumns="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mức độ" Binding="{Binding LevelBadge}" Width="150" MinWidth="130"/>
                                <DataGridTextColumn Header="Dòng / STT" Binding="{Binding RowIndex}" Width="95" MinWidth="85"/>
                                <DataGridTextColumn Header="Hạng mục" Binding="{Binding Category}" Width="160" MinWidth="140"/>
                                <DataGridTextColumn Header="Nội dung kiểm tra chi tiết" Binding="{Binding Message}" Width="*" MinWidth="300"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- BOTTOM STATUS & ACTIONS -->
        <Border Grid.Row="3" Background="{StaticResource NavyCard}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Trạng thái: " Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding ExecutionStatus}" Foreground="{StaticResource MintLight}" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="ĐÓNG" Command="{Binding CloseCommand}" Margin="0,0,10,0" Width="100"/>
                    <Button Content="THỰC HIỆN TẠO MÔ HÌNH" Command="{Binding ExecutePlacementCommand}" Style="{StaticResource BtnExecuteStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
