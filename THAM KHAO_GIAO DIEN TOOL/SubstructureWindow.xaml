<Window x:Class="HIEUVQ.KetCauPhanDuoi.SubstructureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="clr-namespace:HIEUVQ.KetCauPhanDuoi.Models"
        Title="NEXUS TOOL"
        Icon="Resources/KetCauPhanDuoi32.png"
        Width="1120"
        Height="800"
        MinWidth="1120"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#303A49"
        FontFamily="Segoe UI"
        FontSize="11"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#303A49"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#3B4657"/>
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#27313F"/>
        <SolidColorBrush x:Key="InputBrush" Color="#2B3543"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#5B6879"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#48F56A"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F5F7"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#BEC8D2"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFC857"/>
        <SolidColorBrush x:Key="InformationBrush" Color="#7CC8FF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="#647286"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="MaxDropDownHeight" Value="250"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                SnapsToDevicePixels="True"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="27"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="7,0,4,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Border Grid.Column="1" Background="#344152" BorderBrush="#647286" BorderThickness="1,0,0,0">
                                                    <Path Width="8" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Fill="#D8E0E7" Stretch="Fill" Data="M 0 0 L 8 0 L 4 5 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,0" Padding="1"
                                        Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="2">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Background" Value="{StaticResource PanelDarkBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#176B3D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#19864A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelDarkBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#19864A"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#F4F6F8"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#F4F6F8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#344152"/>
            <Setter Property="BorderBrush" Value="#647286"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#19864A"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="SummaryTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7,10,9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CellDisplayCenterStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellEditCenterStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellCheckBoxCenterStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelDarkBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#4B596B"/>
            <Setter Property="RowBackground" Value="#2B3543"/>
            <Setter Property="AlternatingRowBackground" Value="#303C4C"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="27"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Visible"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#344152"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#19864A"/><Setter Property="Foreground" Value="White"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#176B3D"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelDarkBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image Source="Resources/KetCauPhanDuoi32.png" Width="42" Height="42" Stretch="Uniform" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                    <TextBlock Text="NEXUS TOOL" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="KẾT CẤU PHẦN DƯỚI" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainFeatureTabs" Grid.Row="1" Margin="10,7,10,6"
                    SelectionChanged="MainFeatureTabs_SelectionChanged"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TabItem x:Name="FootingFeatureTab" Header="BỆ TRỤ" IsSelected="True">
                <TabControl x:Name="FootingWorkflowTabs" Margin="7" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <TabItem Header="01  KHAI BÁO &amp; VỊ TRÍ" IsSelected="True">
                        <Grid Background="{StaticResource PanelBrush}" Margin="7">
                            <Grid.RowDefinitions><RowDefinition Height="300"/><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                            <GroupBox Grid.Row="0" Grid.Column="0" Header="1. NGUỒN PLACEMENT">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="File Excel" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding SourceFileName}" IsReadOnly="True" Margin="0,0,6,0"/>
                                        <Button Grid.Column="2" Content="CHỌN FILE" Margin="0" Click="BtnLoadExcel_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Sheet dữ liệu" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="CbWorksheet" Margin="0,0,6,0"
                                                  ItemsSource="{Binding WorksheetNames}" SelectedItem="{Binding SelectedWorksheet, Mode=TwoWay}"
                                                  SelectionChanged="CbWorksheet_SelectionChanged"/>
                                        <Button Grid.Column="2" Content="ĐỌC LẠI" Margin="0" Click="BtnReloadExcel_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Phạm vi ô" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding CellRange, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="2" Content="MỞ EXCEL" Margin="0" Click="BtnOpenExcel_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Hệ tọa độ" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Margin="0,0,6,0" SelectedValue="{Binding CoordinateMode}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="VN2000: X=E/W, Y=N/S (m)" Tag="{x:Static model:PlacementCoordinateMode.SharedSurveyMeters}"/>
                                            <ComboBoxItem Content="Project Internal / local (m)" Tag="{x:Static model:PlacementCoordinateMode.ProjectInternalMeters}"/>
                                        </ComboBox>
                                        <Button Grid.Column="2" Content="DỮ LIỆU MẪU" Margin="0" Click="BtnLoadSample_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="4" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Khi trùng khóa" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" SelectedValue="{Binding ExistingElementMode}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Cập nhật theo ElementKey" Tag="{x:Static model:ExistingOwnedElementMode.ReplaceMatchingKeys}"/>
                                            <ComboBoxItem Content="Chặn tạo trùng" Tag="{x:Static model:ExistingOwnedElementMode.BlockDuplicates}"/>
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                            </GroupBox>

                            <Grid Grid.Row="0" Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <GroupBox Header="2. FAMILY CỤM BỆ">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Bệ trụ" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="CbFootingFamily" ItemsSource="{Binding FamilyTypes}" DisplayMemberPath="DisplayName"
                                                      SelectedItem="{Binding Footing.SelectedFamily}" SelectionChanged="CbFootingFamily_SelectionChanged"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Bê tông lót" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="CbBlindingFamily" ItemsSource="{Binding FamilyTypes}" DisplayMemberPath="DisplayName"
                                                      SelectedItem="{Binding Blinding.SelectedFamily}" SelectionChanged="CbBlindingFamily_SelectionChanged"/>
                                        </Grid>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Grid.Row="2" Header="3. HƯỚNG XOAY BỆ">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Nguồn góc" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" SelectedValue="{Binding OrientationMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="Vuông góc tim tuyến CAD" Tag="{x:Static model:PlacementOrientationMode.CadCenterlinePerpendicular}"/>
                                                <ComboBoxItem Content="PlacementYaw từ Excel" Tag="{x:Static model:PlacementOrientationMode.ExcelYaw}"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,4,0,0" IsEnabled="{Binding IsCadOrientation}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="CAD tim tuyến" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding AlignmentCadDisplayName}" IsReadOnly="True" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Content="CHỌN CAD" Margin="0" Click="BtnSelectAlignmentCad_Click"/>
                                        </Grid>
                                        <Grid Grid.Row="2" Margin="0,4,0,0" IsEnabled="{Binding IsCadOrientation}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Layer tim" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AlignmentLayerNames}" SelectedItem="{Binding SelectedAlignmentLayer, Mode=TwoWay}"/>
                                        </Grid>
                                        <Grid Grid.Row="3" Margin="0,4,0,0" IsEnabled="{Binding IsCadOrientation}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Trục Family" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" SelectedValue="{Binding FamilyReferenceAxis, Mode=TwoWay}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="Trục X vuông góc tim" Tag="{x:Static model:FamilyReferenceAxis.XAxis}"/>
                                                <ComboBoxItem Content="Trục Y vuông góc tim" Tag="{x:Static model:FamilyReferenceAxis.YAxis}"/>
                                            </ComboBox>
                                            <CheckBox Grid.Column="2" Content="Đảo 180°" Margin="12,0,0,0" IsChecked="{Binding FlipOrientation180, Mode=TwoWay}"/>
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                            </Grid>

                            <GroupBox Grid.Row="2" Grid.ColumnSpan="3" Header="4. DANH SÁCH VỊ TRÍ CẤU KIỆN">
                                    <DataGrid x:Name="GridPlacements" ItemsSource="{Binding Rows}" IsReadOnly="False"
                                              CellEditEnding="GridPlacement_CellEditEnding"
                                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="STT" Binding="{Binding DisplayIndex}" IsReadOnly="True" Width="46" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
                                            <DataGridTextColumn Header="ElementKey" Binding="{Binding ElementKey, UpdateSourceTrigger=PropertyChanged}" Width="140" ElementStyle="{StaticResource CellDisplayCenterStyle}" EditingElementStyle="{StaticResource CellEditCenterStyle}"/>
                                            <DataGridTextColumn Header="Loại cấu kiện" Binding="{Binding StructureType, UpdateSourceTrigger=PropertyChanged}" Width="120" ElementStyle="{StaticResource CellDisplayCenterStyle}" EditingElementStyle="{StaticResource CellEditCenterStyle}"/>
                                            <DataGridTextColumn Header="X = E/W (m)" Binding="{Binding XMeters, StringFormat=0.000, UpdateSourceTrigger=PropertyChanged}" Width="118" ElementStyle="{StaticResource CellDisplayCenterStyle}" EditingElementStyle="{StaticResource CellEditCenterStyle}"/>
                                            <DataGridTextColumn Header="Y = N/S (m)" Binding="{Binding YMeters, StringFormat=0.000, UpdateSourceTrigger=PropertyChanged}" Width="118" ElementStyle="{StaticResource CellDisplayCenterStyle}" EditingElementStyle="{StaticResource CellEditCenterStyle}"/>
                                            <DataGridTextColumn Header="Z (m)" Binding="{Binding ZMeters, StringFormat=0.000, UpdateSourceTrigger=PropertyChanged}" Width="88" ElementStyle="{StaticResource CellDisplayCenterStyle}" EditingElementStyle="{StaticResource CellEditCenterStyle}"/>
                                            <DataGridTextColumn Header="Góc Excel dự phòng (°)" Binding="{Binding PlacementYawDegrees, StringFormat=0.00, UpdateSourceTrigger=PropertyChanged}" Width="145" ElementStyle="{StaticResource CellDisplayCenterStyle}" EditingElementStyle="{StaticResource CellEditCenterStyle}"/>
                                            <DataGridTextColumn Header="Góc dùng (°)" Binding="{Binding ResolvedYawDegrees, StringFormat=0.00}" IsReadOnly="True" Width="105" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
