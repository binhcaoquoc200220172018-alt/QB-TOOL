                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Grid.Column="2" Header="2. GIÁ TRỊ THÂN TRỤ">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
                                    <DataGrid Grid.Row="1" x:Name="PierGridDynamicValues" Margin="0,5,0,4" ItemsSource="{Binding Rows}"
                                              IsReadOnly="False" SelectionUnit="CellOrRowHeader" CellEditEnding="PierGridDynamicValues_CellEditEnding"
                                              ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible"/>
                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding PierColumn.SelectedParameters}" SelectedItem="{Binding PierColumn.SelectedApplyParameter}" HorizontalContentAlignment="Left">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox Grid.Column="1" Margin="6,0,0,0" Text="{Binding PierColumn.ApplyValue, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/><ColumnDefinition Width="52"/><ColumnDefinition Width="36"/><ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="132"/><ColumnDefinition Width="76"/><ColumnDefinition Width="76"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Từ STT" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding PierColumn.ApplyFromIndex, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="đến" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="3" Text="{Binding PierColumn.ApplyToIndex, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                            <Button Grid.Column="4" Content="ÁP DỤNG TỪ–ĐẾN" Margin="5,0,0,0" Click="PierBtnApplyRange_Click"/>
                                            <Button Grid.Column="5" Content="TẤT CẢ" Margin="5,0,0,0" Click="PierBtnApplyAll_Click"/>
                                            <Button Grid.Column="6" Content="XÓA" Margin="5,0,0,0" Click="PierBtnClearValues_Click"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="03  KẾT QUẢ">
                        <Grid Background="{StaticResource PanelBrush}" Margin="7">
                            <GroupBox Header="KẾT QUẢ KIỂM TRA THÂN TRỤ">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SummaryTileStyle}"><StackPanel><TextBlock Text="KẾT LUẬN" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding ValidationConclusion}" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel></Border>
                                        <Border Grid.Column="2" Style="{StaticResource SummaryTileStyle}"><StackPanel><TextBlock Text="LỖI" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding ValidationErrorCount}" Foreground="{StaticResource ErrorBrush}" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                                        <Border Grid.Column="4" Style="{StaticResource SummaryTileStyle}"><StackPanel><TextBlock Text="CẢNH BÁO" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding ValidationWarningCount}" Foreground="{StaticResource WarningBrush}" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                                        <Border Grid.Column="6" Style="{StaticResource SummaryTileStyle}"><StackPanel><TextBlock Text="THÔNG TIN" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding ValidationInformationCount}" Foreground="{StaticResource InformationBrush}" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                                    </Grid>
                                    <DataGrid Grid.Row="2" x:Name="PierGridValidation" ItemsSource="{Binding ValidationIssues}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible" CanUserResizeColumns="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mức" Binding="{Binding SeverityLabel}" Width="96" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
                                            <DataGridTextColumn Header="Dòng Excel" Binding="{Binding RowLabel}" Width="175" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
                                            <DataGridTextColumn Header="Hạng mục" Binding="{Binding Field}" Width="165" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
                                            <DataGridTextColumn Header="Nội dung kiểm tra" Binding="{Binding Message}" Width="1200" MinWidth="800"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem x:Name="PierCapFeatureTab" Header="XÀ MŨ">
                <TabControl x:Name="CapWorkflowTabs" Margin="7" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <TabItem Header="01  KHAI BÁO &amp; VỊ TRÍ" IsSelected="True">
                        <Grid Background="{StaticResource PanelBrush}" Margin="7">
                            <Grid.RowDefinitions><RowDefinition Height="300"/><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                            <GroupBox Grid.Row="0" Grid.Column="0" Header="1. NGUỒN PLACEMENT XÀ MŨ">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="File Excel" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding SourceFileName}" IsReadOnly="True" Margin="0,0,6,0"/>
                                        <Button Grid.Column="2" Content="CHỌN FILE" Margin="0" Click="CapBtnLoadExcel_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Sheet dữ liệu" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Margin="0,0,6,0" ItemsSource="{Binding WorksheetNames}"
                                                  SelectedItem="{Binding SelectedWorksheet, Mode=TwoWay}"
                                                  SelectionChanged="CapCbWorksheet_SelectionChanged"/>
                                        <Button Grid.Column="2" Content="ĐỌC LẠI" Margin="0" Click="CapBtnReloadExcel_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Phạm vi ô" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding CellRange, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="2" Content="MỞ EXCEL" Margin="0" Click="CapBtnOpenExcel_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Hệ tọa độ" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Margin="0,0,6,0" SelectedValue="{Binding CoordinateMode}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="VN2000: X=E/W, Y=N/S (m)" Tag="{x:Static model:PlacementCoordinateMode.SharedSurveyMeters}"/>
                                            <ComboBoxItem Content="Project Internal / local (m)" Tag="{x:Static model:PlacementCoordinateMode.ProjectInternalMeters}"/>
                                        </ComboBox>
                                        <Button Grid.Column="2" Content="DỮ LIỆU MẪU" Margin="0" Click="CapBtnLoadSample_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="4" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Khi trùng khóa" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" SelectedValue="{Binding ExistingElementMode}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Cập nhật theo ElementKey" Tag="{x:Static model:ExistingOwnedElementMode.ReplaceMatchingKeys}"/>
                                            <ComboBoxItem Content="Chặn tạo trùng" Tag="{x:Static model:ExistingOwnedElementMode.BlockDuplicates}"/>
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                            </GroupBox>

                            <Grid Grid.Row="0" Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <GroupBox Header="2. FAMILY XÀ MŨ">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Family xà mũ" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Margin="0,0,6,0" ItemsSource="{Binding FamilyTypes}" DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding PierCap.SelectedFamily}" SelectionChanged="CapCbFamily_SelectionChanged"/>
                                        <Button Grid.Column="2" Content="LÀM MỚI" Margin="0" Click="CapBtnRefreshFamily_Click"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Grid.Row="2" Header="3. HƯỚNG XOAY XÀ MŨ">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox Grid.Row="0" Content="DÙNG NGUỒN HƯỚNG CỦA BỆ"
                                                  IsChecked="{Binding UseFootingOrientationSource, Mode=TwoWay}"/>
                                        <Grid Grid.Row="1" Margin="0,4,0,0" IsEnabled="{Binding CanEditOwnOrientation}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Nguồn góc riêng" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" SelectedValue="{Binding OrientationMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="Vuông góc tim tuyến CAD" Tag="{x:Static model:PlacementOrientationMode.CadCenterlinePerpendicular}"/>
                                                <ComboBoxItem Content="PlacementYaw từ Excel" Tag="{x:Static model:PlacementOrientationMode.ExcelYaw}"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Grid.Row="2" Margin="0,4,0,0" IsEnabled="{Binding CanSelectOwnCad}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="CAD tim tuyến" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding AlignmentCadDisplayName}" IsReadOnly="True" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Content="CHỌN CAD" Margin="0" Click="CapBtnSelectAlignmentCad_Click"/>
                                        </Grid>
                                        <Grid Grid.Row="3" Margin="0,4,0,0" IsEnabled="{Binding CanSelectOwnCad}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Layer tim" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AlignmentLayerNames}" SelectedItem="{Binding SelectedAlignmentLayer, Mode=TwoWay}"/>
                                        </Grid>
                                        <Grid Grid.Row="4" Margin="0,4,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Trục Family" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" SelectedValue="{Binding FamilyReferenceAxis, Mode=TwoWay}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="Trục X vuông góc tim" Tag="{x:Static model:FamilyReferenceAxis.XAxis}"/>
                                                <ComboBoxItem Content="Trục Y vuông góc tim" Tag="{x:Static model:FamilyReferenceAxis.YAxis}"/>
                                            </ComboBox>
                                            <CheckBox Grid.Column="2" Content="Đảo 180°" Margin="12,0,0,0" IsChecked="{Binding FlipOrientation180, Mode=TwoWay}"/>
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                            </Grid>

                            <GroupBox Grid.Row="2" Grid.ColumnSpan="3" Header="4. DANH SÁCH VỊ TRÍ CẤU KIỆN">
                                <DataGrid x:Name="CapGridPlacements" ItemsSource="{Binding Rows}" IsReadOnly="False"
                                          CellEditEnding="CapGridPlacement_CellEditEnding"
                                          ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                          ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT" Binding="{Binding DisplayIndex}" IsReadOnly="True" Width="46" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
                                        <DataGridTextColumn Header="ElementKey" Binding="{Binding ElementKey, UpdateSourceTrigger=PropertyChanged}" Width="140" ElementStyle="{StaticResource CellDisplayCenterStyle}" EditingElementStyle="{StaticResource CellEditCenterStyle}"/>
                                        <DataGridTextColumn Header="Loại cấu kiện" Binding="{Binding StructureType, UpdateSourceTrigger=PropertyChanged}" Width="120" ElementStyle="{StaticResource CellDisplayCenterStyle}" EditingElementStyle="{StaticResource CellEditCenterStyle}"/>
                                        <DataGridTextColumn Header="X = E/W (m)" Binding="{Binding XMeters, StringFormat=0.000, UpdateSourceTrigger=PropertyChanged}" Width="118" ElementStyle="{StaticResource CellDisplayCenterStyle}" EditingElementStyle="{StaticResource CellEditCenterStyle}"/>
                                        <DataGridTextColumn Header="Y = N/S (m)" Binding="{Binding YMeters, StringFormat=0.000, UpdateSourceTrigger=PropertyChanged}" Width="118" ElementStyle="{StaticResource CellDisplayCenterStyle}" EditingElementStyle="{StaticResource CellEditCenterStyle}"/>
                                        <DataGridTextColumn Header="Z (m)" Binding="{Binding ZMeters, StringFormat=0.000, UpdateSourceTrigger=PropertyChanged}" Width="88" ElementStyle="{StaticResource CellDisplayCenterStyle}" EditingElementStyle="{StaticResource CellEditCenterStyle}"/>
                                        <DataGridTextColumn Header="Góc Excel dự phòng (°)" Binding="{Binding PlacementYawDegrees, StringFormat=0.00, UpdateSourceTrigger=PropertyChanged}" Width="145" ElementStyle="{StaticResource CellDisplayCenterStyle}" EditingElementStyle="{StaticResource CellEditCenterStyle}"/>
                                        <DataGridTextColumn Header="Góc dùng (°)" Binding="{Binding ResolvedYawDegrees, StringFormat=0.00}" IsReadOnly="True" Width="105" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="02  PARAMETER">
                        <Grid Background="{StaticResource PanelBrush}" Margin="7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <GroupBox Grid.Column="0" Header="1. PARAMETER XÀ MŨ">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding PierCap.ParameterSearch, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox Grid.Column="1" Content="Hiện tất cả" IsChecked="{Binding PierCap.ShowAllParameters}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <DataGrid Grid.Row="1" x:Name="CapGridParameterCatalog" Margin="0,5,0,4" SelectionMode="Single"
                                              ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Dùng" Width="48">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><Grid><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding IsMvpEditable}" Style="{StaticResource CellCheckBoxCenterStyle}" Click="CapParameterCheckBox_Click"/></Grid></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Tên parameter" Binding="{Binding DisplayName}" Width="*" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
                                            <DataGridTextColumn Header="Scope" Binding="{Binding ScopeLabel}" Width="64" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
                                            <DataGridTextColumn Header="Kiểu" Binding="{Binding DataTypeLabel}" Width="104" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button Content="QUÉT LẠI" Click="CapBtnRefreshParameters_Click"/>
                                        <Button Content="BỎ CHỌN TẤT CẢ" Click="CapBtnClearParameterSelection_Click"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Grid.Column="2" Header="2. GIÁ TRỊ XÀ MŨ">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
                                    <DataGrid Grid.Row="1" x:Name="CapGridDynamicValues" Margin="0,5,0,4" ItemsSource="{Binding Rows}"
                                              IsReadOnly="False" SelectionUnit="CellOrRowHeader" CellEditEnding="CapGridDynamicValues_CellEditEnding"
                                              ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible"/>
                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding PierCap.SelectedParameters}" SelectedItem="{Binding PierCap.SelectedApplyParameter}" HorizontalContentAlignment="Left">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox Grid.Column="1" Margin="6,0,0,0" Text="{Binding PierCap.ApplyValue, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/><ColumnDefinition Width="52"/><ColumnDefinition Width="36"/><ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="132"/><ColumnDefinition Width="76"/><ColumnDefinition Width="76"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Từ STT" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding PierCap.ApplyFromIndex, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="đến" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="3" Text="{Binding PierCap.ApplyToIndex, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                                            <Button Grid.Column="4" Content="ÁP DỤNG TỪ–ĐẾN" Margin="5,0,0,0" Click="CapBtnApplyRange_Click"/>
                                            <Button Grid.Column="5" Content="TẤT CẢ" Margin="5,0,0,0" Click="CapBtnApplyAll_Click"/>
                                            <Button Grid.Column="6" Content="XÓA" Margin="5,0,0,0" Click="CapBtnClearValues_Click"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="03  KẾT QUẢ">
                        <Grid Background="{StaticResource PanelBrush}" Margin="7">
                            <GroupBox Header="KẾT QUẢ KIỂM TRA XÀ MŨ">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SummaryTileStyle}"><StackPanel><TextBlock Text="KẾT LUẬN" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding ValidationConclusion}" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/></StackPanel></Border>
                                        <Border Grid.Column="2" Style="{StaticResource SummaryTileStyle}"><StackPanel><TextBlock Text="LỖI" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding ValidationErrorCount}" Foreground="{StaticResource ErrorBrush}" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                                        <Border Grid.Column="4" Style="{StaticResource SummaryTileStyle}"><StackPanel><TextBlock Text="CẢNH BÁO" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding ValidationWarningCount}" Foreground="{StaticResource WarningBrush}" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                                        <Border Grid.Column="6" Style="{StaticResource SummaryTileStyle}"><StackPanel><TextBlock Text="THÔNG TIN" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/><TextBlock Text="{Binding ValidationInformationCount}" Foreground="{StaticResource InformationBrush}" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                                    </Grid>
                                    <DataGrid Grid.Row="2" x:Name="CapGridValidation" ItemsSource="{Binding ValidationIssues}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible" CanUserResizeColumns="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mức" Binding="{Binding SeverityLabel}" Width="96" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
                                            <DataGridTextColumn Header="Dòng Excel" Binding="{Binding RowLabel}" Width="175" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
                                            <DataGridTextColumn Header="Hạng mục" Binding="{Binding Field}" Width="165" ElementStyle="{StaticResource CellDisplayCenterStyle}"/>
                                            <DataGridTextColumn Header="Nội dung kiểm tra" Binding="{Binding Message}" Width="1200" MinWidth="800"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem x:Name="AbutmentFeatureTab" Header="MỐ">
                <Border Style="{StaticResource PanelCardStyle}" Margin="14" VerticalAlignment="Top">
                    <StackPanel><TextBlock Text="MỐ" Style="{StaticResource SectionTitleStyle}"/></StackPanel>
                </Border>
            </TabItem>
            <TabItem x:Name="PileFeatureTab" Header="CỌC">
                <ContentControl x:Name="PilePanelHost"/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource PanelDarkBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TbStatus" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="Đang khởi tạo..." TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="ĐÓNG" MinWidth="78" Click="BtnClose_Click"/>
                    <Button x:Name="BtnValidate" Content="KIỂM TRA" MinWidth="94" Click="BtnValidate_Click"/>
                    <Button x:Name="BtnExecute" Content="THỰC HIỆN" MinWidth="98" Style="{StaticResource PrimaryButtonStyle}" Click="BtnExecute_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
