                                        <Button Grid.Column="2" Content="DỮ LIỆU MẪU" Margin="0" Click="PierBtnLoadSample_Click"/>
                                    </Grid>
                                    <Grid Grid.Row="4" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Khi trùng khóa" VerticalAlignment="Center"/>
